--- /dev/null
+++ b/windows/src/core/agent-room.ts
@@ -0,0 +1,33 @@
+import { CodexFlow } from "./codex-flow";
+import type { AgentTask } from "./state";
+import type { BotStateName } from "./layout";
+import { pillDefinition } from "./pills";
+import { t, N_ } from "../i18n/i18n";
+
+/** Only agents/workspaces that actually exist in Coucou; services aren't workers. */
+export function roomAgents(tasks: AgentTask[]): AgentTask[] {
+  const agents = tasks.filter(task => {
+    const category = pillDefinition(task.id)?.category;
+    return category === "workspace" || category === "agent" ||
+      (!task.isIntegration && (task.source === "agent" || task.source === "claudeCode"));
+  });
+  const hook = agents.find(task => task.id === "agent_codex");
+  if (!CodexFlow.tasks.length || !hook) return agents;
+  // Expand Codex in place; its snapshot must not hide other hook-driven agents.
+  const flow = CodexFlow.tasks.map(task => task.id === hook.id &&
+    ["question", "approval", "ratelimit", "error"].includes(hook.state)
+    ? { ...task, state: hook.state } : task);
+  const flowIds = new Set(flow.map(task => task.id));
+  return agents.flatMap(task => task.id === hook.id ? flow : flowIds.has(task.id) ? [] : [task]);
+}
+const STATUS: Record<BotStateName, [string, string]> = {
+  idle: ["○", N_("Ready")], working: ["▶", N_("Working")], thinking: ["◌", N_("Thinking")],
+  searching: ["⌕", N_("Searching")], approval: ["!", N_("Needs permission")],
+  question: ["?", N_("Needs an answer")], error: ["!", N_("Error")],
+  finished: ["✓", N_("Finished")], ratelimit: ["Ⅱ", N_("Rate limited")],
+  sleeping: ["z", N_("Sleeping")], dizzy: ["~", N_("Recovering")],
+};
+export function agentStatus(state: BotStateName): string {
+  const [symbol, label] = STATUS[state];
+  return `${symbol} ${t(label)}`;
+}

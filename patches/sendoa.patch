+//! Read-only, bounded view of Codex rollout metadata. Never return conversation
+//! text, tool arguments/results, prompts, reasoning, or raw parser errors.
+
+use serde::Serialize;
+use serde_json::Value;
+use std::collections::{HashMap, HashSet};
+use std::fs::{self, File, Metadata, OpenOptions};
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+
+const MAX_FILES: usize = 256;
+const MAX_ENTRIES: usize = 20_000;
+const MAX_LINE: usize = 1024 * 1024;
+const MAX_FILE_READ: usize = 2 * 1024 * 1024;
+const MAX_POLL_READ: usize = 16 * 1024 * 1024;
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Agent {
+    id: String,
+    parent_id: Option<String>,
+    name: String,
+    role: Option<String>,
+    model: Option<String>,
+    effort: Option<String>,
+    status: &'static str,
+    tool: Option<String>,
+    last_seen: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Snapshot {
+    root_id: Option<String>,
+    agents: Vec<Agent>,
+    pub(crate) truncated: bool,
+    warnings: Vec<&'static str>,
+}
+
+#[derive(Default)]
+struct Rollout {
+    offset: u64,
+    pending: Vec<u8>,
+    skipping_line: bool,
+    first_line: bool,
+    identity: Option<(u64, u64)>,
+    modified: Option<std::time::SystemTime>,
+    agent: Option<Agent>,
+    root: bool,
+    limited: bool,
+    incomplete: bool,
+}
+
+impl Rollout {
+    fn fresh(metadata: &Metadata) -> Self {
+        Self { first_line: true, identity: file_identity(metadata), modified: metadata.modified().ok(), incomplete: true, ..Self::default() }
+    }
+
+    fn line(&mut self, line: &[u8]) {
+        let first = self.first_line;
+        self.first_line = false;
+        let Ok(record) = serde_json::from_slice::<Value>(line) else { return };
+        let payload = &record["payload"];
+        if first {
+            if record["type"] != "session_meta" { return; }
+            let Some(id) = payload["id"].as_str().filter(|id| valid_id(id)) else { return };
+            let source = &payload["source"];
+            if source.pointer("/subagent/other").and_then(Value::as_str) == Some("guardian") { return; }
+            let spawn = source.pointer("/subagent/thread_spawn");
+            // Guardians and other internal subagent sources are deliberately
+            // excluded, even if they happen to declare a parent_thread_id.
+            self.root = source.is_string() && source.as_str() != Some("subagent")
+                && payload["parent_thread_id"].is_null();
+            let parent = if let Some(spawn) = spawn {
+                spawn["parent_thread_id"].as_str()
+                    .or_else(|| payload["parent_thread_id"].as_str())
+                    .filter(|id| valid_id(id)).map(str::to_owned)
+            } else { None };
+            if !self.root && parent.is_none() { return; }
+            let role = spawn.and_then(|s| label(&s["agent_role"]));
+            let name = spawn.and_then(|s| label(&s["agent_path"]))
+                .and_then(|path| path.rsplit('/').find(|part| !part.is_empty()).map(str::to_owned))
+                .or_else(|| spawn.and_then(|s| label(&s["agent_nickname"])))
+                .unwrap_or_else(|| if self.root { "Codex".into() } else { "Subagente".into() });
+            self.agent = Some(Agent {
+                id: id.into(), parent_id: parent, name, role,
+                model: label(&payload["model"]), effort: None,
+                status: "unknown", tool: None, last_seen: timestamp(&record["timestamp"]),
+            });
+            return;
+        }
+        let Some(agent) = self.agent.as_mut() else { return };
+        // An old event in an out-of-order append cannot reverse current state.
+        let time = timestamp(&record["timestamp"]);
+        if let (Some(new), Some(old)) = (&time, &agent.last_seen) {
+            if new < old { return; }
+        }
+        match record["type"].as_str() {
+            Some("event_msg") => match payload["type"].as_str() {
+                Some("task_started") => { agent.status = "working"; agent.tool = None; }
+                Some("task_complete") => { agent.status = "completed"; agent.tool = None; }
+                Some("turn_aborted") => { agent.status = "interrupted"; agent.tool = None; }
+                _ => {}
+            },
+            Some("turn_context") => {
+                agent.model = label(&payload["model"]);
+                agent.effort = label(&payload["effort"]);
+            }
+            Some("response_item") if matches!(payload["type"].as_str(), Some("function_call" | "custom_tool_call")) => {
+                if agent.status == "working" {
+                    agent.tool = label(&payload["name"]).map(|name| {
+                        label(&payload["namespace"]).map(|ns| format!("{ns}.{name}")).unwrap_or(name)
+                    });
+                }
+            }
+            _ => {}
+        }
+        if time.is_some() { agent.last_seen = time; }
+    }
+
+    fn consume(&mut self, bytes: &[u8]) {
+        for &byte in bytes {
+            if byte == b'\n' {
+                if !self.skipping_line {
+                    let line = std::mem::take(&mut self.pending);
+                    self.line(&line);
+                } else { self.first_line = false; }
+                self.pending.clear();
+                self.skipping_line = false;
+            } else if !self.skipping_line {
+                if self.pending.len() < MAX_LINE { self.pending.push(byte); }
+                else {
+                    self.pending.clear();
+                    self.skipping_line = true;
+                    self.limited = true;
+                    if let Some(agent) = self.agent.as_mut() {
+                        agent.status = "unknown";
+                        agent.tool = None;
+                    }
+                }
+            }
+        }
+    }
+
+    fn update(&mut self, mut file: File, metadata: &Metadata, budget: usize) -> std::io::Result<usize> {
+        if metadata.len() < self.offset || self.identity != file_identity(metadata)
+            || (metadata.len() == self.offset && self.modified != metadata.modified().ok()) {
+            *self = Self::fresh(metadata);
+        }
+        file.seek(SeekFrom::Start(self.offset))?;
+        let mut remaining = budget.min(MAX_FILE_READ);
+        let mut read = 0;
+        let mut bytes = [0u8; 64 * 1024];
+        while remaining > 0 {
+            let len = bytes.len().min(remaining);
+            let n = file.read(&mut bytes[..len])?;
+            if n == 0 { break; }
+            self.consume(&bytes[..n]);
+            self.offset += n as u64;
+            remaining -= n;
+            read += n;
+        }
+        self.modified = metadata.modified().ok();
+        self.incomplete = self.offset < file.metadata()?.len() || !self.pending.is_empty() || self.skipping_line;
+        Ok(read)
+    }
+}
+
+fn valid_id(id: &str) -> bool {
+    id.len() == 36 && id.bytes().enumerate().all(|(i, c)| {
+        if matches!(i, 8 | 13 | 18 | 23) { c == b'-' } else { c.is_ascii_hexdigit() }
+    })
+}
+
+fn label(value: &Value) -> Option<String> {
+    value.as_str().filter(|s| !s.is_empty() && s.len() <= 160 && !s.chars().any(char::is_control)).map(str::to_owned)
+}
+
+// Rollouts use UTC ISO timestamps; accept that exact sortable shape only.
+fn timestamp(value: &Value) -> Option<String> {
+    let s = value.as_str()?;
+    let b = s.as_bytes();
+    if !(20..=30).contains(&b.len()) || b.last() != Some(&b'Z') { return None; }
+    for (i, &c) in b[..19].iter().enumerate() {
+        let expected = match i { 4 | 7 => Some(b'-'), 10 => Some(b'T'), 13 | 16 => Some(b':'), _ => None };
+        if expected.map(|e| c != e).unwrap_or(!c.is_ascii_digit()) { return None; }
+    }
+    if b.len() > 20 && (b[19] != b'.' || !b[20..b.len()-1].iter().all(u8::is_ascii_digit)) { return None; }
+    // Normalize fractional precision so comparisons remain chronological when
+    // one record uses whole seconds and another milliseconds or microseconds.
+    let fraction = if b.len() > 20 { &s[20..s.len()-1] } else { "" };
+    Some(format!("{}.{:0<9}Z", &s[..19], fraction))
+}
+
+#[cfg(unix)]
+fn file_identity(metadata: &Metadata) -> Option<(u64, u64)> {
+    use std::os::unix::fs::MetadataExt;
+    Some((metadata.dev(), metadata.ino()))
+}
+#[cfg(not(unix))]
+fn file_identity(_: &Metadata) -> Option<(u64, u64)> { None }
+
+/// Reject symlinks in the path as well as the final file. Linux also opens the
+/// final component with O_NOFOLLOW, closing the usual check/open race there.
+fn no_symlinks(path: &Path) -> bool {
+    let mut checked = PathBuf::new();
+    path.components().all(|part| {
+        checked.push(part);
+        fs::symlink_metadata(&checked).map(|m| !m.file_type().is_symlink()).unwrap_or(false)
+    })
+}
+
+fn open_rollout(path: &Path) -> std::io::Result<File> {
+    if !no_symlinks(path) { return Err(std::io::ErrorKind::PermissionDenied.into()); }
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(target_os = "linux")]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::OpenOptionsExt;
+        options.custom_flags(0x00200000); // FILE_FLAG_OPEN_REPARSE_POINT
+    }
+    let file = options.open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() || metadata.file_type().is_symlink() { return Err(std::io::ErrorKind::InvalidData.into()); }
+    Ok(file)
+}
+
+#[derive(Default)]
+struct Cache { files: HashMap<PathBuf, Rollout> }
+
+impl Cache {
+    fn snapshot(&mut self, directory: &Path, requested: Option<&str>) -> Snapshot {
+        let mut warnings = Vec::new();
+        let mut limited = false;
+        let mut paths = Vec::new();
+        let mut entries = 0;
+        if no_symlinks(directory) {
+            discover(directory, 0, &mut entries, &mut paths, &mut limited);
+        } else { warnings.push("sessions_unavailable"); }
+        // Recent files first; unchanged files need no content I/O next poll.
+        paths.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| b.0.cmp(&a.0)));
+        if paths.len() > MAX_FILES { paths.truncate(MAX_FILES); limited = true; }
+        let present: HashSet<_> = paths.iter().map(|(p, _)| p.clone()).collect();
+        self.files.retain(|path, _| present.contains(path));
+        let mut budget = MAX_POLL_READ;
+        let mut latest_root: Option<(std::time::SystemTime, String)> = None;
+        for (path, _) in paths {
+            if let Some(rollout) = self.files.get_mut(&path) { rollout.incomplete = true; }
+            let Ok(file) = open_rollout(&path) else { warnings.push("session_unreadable"); limited = true; continue };
+            let Ok(meta) = file.metadata() else { warnings.push("session_unreadable"); limited = true; continue };
+            let rollout = self.files.entry(path).or_insert_with(|| Rollout::fresh(&meta));
+            match rollout.update(file, &meta, budget) {
+                Ok(read) => budget -= read,
+                Err(_) => { warnings.push("session_unreadable"); limited = true; },
+            }
+            if rollout.root {
+                if let Some(agent) = &rollout.agent {
+                    let candidate = (meta.modified().unwrap_or(std::time::UNIX_EPOCH), agent.id.clone());
+                    if latest_root.as_ref().map(|old| &candidate > old).unwrap_or(true) { latest_root = Some(candidate); }
+                }
+            }
+            limited |= rollout.incomplete || rollout.limited;
+        }
+        let all: HashMap<_, _> = self.files.values().filter_map(|r| r.agent.as_ref().map(|a| (a.id.clone(), (a, r.root)))).collect();
+        // Hooks may identify a spawned session. Follow only validated metadata
+        // parents; an incomplete or cyclic chain never falls back to another chat.
+        let root_id = requested.map(|id| {
+            let mut current = id;
+            let mut seen = HashSet::new();
+            while seen.insert(current) {
+                match all.get(current) {
+                    Some((agent, false)) => match agent.parent_id.as_deref() {
+                        Some(parent) => current = parent,
+                        None => break,
+                    },
+                    _ => break,
+                }
+            }
+            current.to_owned()
+        }).or_else(|| latest_root.map(|(_, id)| id));
+        let mut agents = Vec::new();
+        if let Some(root) = root_id.as_deref() {
+            // The resolved ID must be a genuine root. Missing parents, cycles
+            // and guardians produce an empty exact tree.
+            if let Some((agent, true)) = all.get(root) {
+                agents.push((*agent).clone());
+                let mut seen = HashSet::from([root.to_owned()]);
+                loop {
+                    let mut next: Vec<_> = all.values().filter(|(a, _)| !seen.contains(&a.id)
+                        && a.parent_id.as_ref().map(|p| seen.contains(p)).unwrap_or(false))
+                        .map(|(a, _)| (*a).clone()).collect();
+                    if next.is_empty() { break; }
+                    next.sort_by(|a, b| a.id.cmp(&b.id));
+                    for a in next { seen.insert(a.id.clone()); agents.push(a); }
+                }
+            } else { warnings.push("root_not_found"); }
+        }
+        if limited { warnings.push("bounded_history"); }
+        // A bounded read may stop in the middle of a live turn or before a
+        // terminal event. Never present that historical state as current.
+        let incomplete: HashSet<_> = self.files.values().filter(|r| r.incomplete)
+            .filter_map(|r| r.agent.as_ref().map(|a| a.id.as_str())).collect();
+        for agent in &mut agents {
+            if incomplete.contains(agent.id.as_str()) {
+                agent.status = "unknown";
+                agent.tool = None;
+            }
+        }
+        warnings.sort_unstable(); warnings.dedup();
+        Snapshot { root_id, agents, truncated: limited, warnings }
+    }
+}
+
+/// Only YYYY/MM/DD/rollout*.jsonl, bounded directory work and no symlink descent.
+fn discover(dir: &Path, depth: usize, entries: &mut usize, paths: &mut Vec<(PathBuf, std::time::SystemTime)>, limited: &mut bool) {
+    let Ok(read) = fs::read_dir(dir) else { *limited = true; return };
+    let mut children = Vec::new();
+    for entry in read {
+        if *entries >= MAX_ENTRIES { *limited = true; break; }
+        *entries += 1;
+        let Ok(entry) = entry else { *limited = true; continue };
+        let Ok(kind) = entry.file_type() else { continue };
+        if kind.is_symlink() { continue; }
+        let name = entry.file_name().to_string_lossy().into_owned();
+        if depth < 3 {
+            let width = if depth == 0 { 4 } else { 2 };
+            if kind.is_dir() && name.len() == width && name.bytes().all(|c| c.is_ascii_digit()) {
+                children.push(entry.path());
+            }
+        } else if kind.is_file() && name.starts_with("rollout") && name.ends_with(".jsonl") {
+            if let Ok(meta) = entry.metadata() {
+                paths.push((entry.path(), meta.modified().unwrap_or(std::time::UNIX_EPOCH)));
+            }
+        }
+    }
+    children.sort_by(|a, b| b.cmp(a));
+    for child in children {
+        if *entries >= MAX_ENTRIES { *limited = true; break; }
+        discover(&child, depth + 1, entries, paths, limited);
+    }
+}
+
+static CACHE: OnceLock<Mutex<Cache>> = OnceLock::new();
+
+pub fn read(root_thread_id: Option<String>) -> Result<Snapshot, String> {
+    if root_thread_id.as_deref().map(|id| !valid_id(id)).unwrap_or(false) {
+        return Err("Invalid Codex root thread ID".into());
+    }
+    let codex_home = std::env::var_os("CODEX_HOME").filter(|value| !value.is_empty())
+        .map(PathBuf::from).unwrap_or_else(|| crate::platform::home_dir().join(".codex"));
+    let directory = codex_home.join("sessions");
+    // ponytail: one global lock serializes bounded polls; split only if measured
+    // contention warrants it. No watcher, daemon, or extra dependency.
+    let mut cache = CACHE.get_or_init(|| Mutex::new(Cache::default())).lock()
+        .map_err(|_| "Codex session monitor unavailable".to_owned())?;
+    Ok(cache.snapshot(&directory, root_thread_id.as_deref()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    const ROOT: &str = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa";
+    const CHILD: &str = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb";
+    const OTHER: &str = "cccccccc-cccc-cccc-cccc-cccccccccccc";
+
+    fn record(kind: &str, payload: Value) -> Vec<u8> {
+        let mut out = serde_json::to_vec(&json!({"timestamp":"2026-10-21T10:00:00.000Z", "type":kind,"payload":payload})).unwrap();
+        out.push(b'\n'); out
+    }
+    fn rollout(id: &str, source: Value, parent: Option<&str>) -> Rollout {
+        let mut r = Rollout { first_line: true, ..Rollout::default() };
+        r.consume(&record("session_meta", json!({"id":id,"source":source,"parent_thread_id":parent})));
+        r
+    }
+    fn state(r: &mut Rollout, state: &str) { r.consume(&record("event_msg", json!({"type":state}))); }
+
+    #[test]
+    fn metadata_accepts_only_roots_and_spawned_agents() {
+        let root = rollout(ROOT, json!("vscode"), None);
+        assert!(root.root);
+        let child = rollout(CHILD, json!({"subagent":{"thread_spawn":{"parent_thread_id":ROOT,"agent_role":"explorer","agent_nickname":"Luna","agent_path":"/root/explore"}}}), Some(ROOT));
+        let agent = child.agent.unwrap();
+        assert_eq!(agent.parent_id.as_deref(), Some(ROOT));
+        assert_eq!(agent.name, "explore"); assert_eq!(agent.role.as_deref(), Some("explorer"));
+        assert!(rollout(CHILD, json!({"subagent":{"other":"guardian"}}), Some(ROOT)).agent.is_none());
+        assert!(rollout(CHILD, json!({"subagent":{"other":"unknown"}}), Some(ROOT)).agent.is_none());
+        assert!(rollout("invalid", json!("vscode"), None).agent.is_none());
+    }
+
+    #[test]
+    fn turn_states_and_new_turn_clear_stale_tools() {
+        let mut r = rollout(ROOT, json!("vscode"), None);
+        assert_eq!(r.agent.as_ref().unwrap().status, "unknown");
+        state(&mut r, "task_started");
+        r.consume(&record("turn_context", json!({"model":"gpt-6.1-sol","effort":"high"})));
+        r.consume(&record("response_item", json!({"type":"function_call","name":"exec_command","namespace":"functions","arguments":"SECRET"})));
+        assert_eq!(r.agent.as_ref().unwrap().tool.as_deref(), Some("functions.exec_command"));
+        state(&mut r, "task_complete");
+        assert_eq!(r.agent.as_ref().unwrap().status, "completed");
+        assert!(r.agent.as_ref().unwrap().tool.is_none());
+        state(&mut r, "task_started");
+        assert_eq!(r.agent.as_ref().unwrap().status, "working");
+        assert!(r.agent.as_ref().unwrap().tool.is_none());
+        state(&mut r, "turn_aborted");
+        assert_eq!(r.agent.as_ref().unwrap().status, "interrupted");
+        assert_eq!(r.agent.as_ref().unwrap().effort.as_deref(), Some("high"));
+    }
+
+    #[test]
+    fn privacy_allowlist_ignores_content_and_outputs() {
+        let mut r = rollout(ROOT, json!("vscode"), None);
+        state(&mut r, "task_started");
+        r.consume(&record("response_item", json!({"type":"custom_tool_call","name":"apply_patch","input":"SECRET_INPUT","output":"SECRET_OUTPUT","arguments":"SECRET_ARGS"})));
+        r.consume(&record("response_item", json!({"type":"reasoning","text":"SECRET_REASONING"})));
+        r.consume(&record("event_msg", json!({"type":"user_message","message":"SECRET_PROMPT"})));
+        let encoded = serde_json::to_string(&r.agent).unwrap();
+        assert!(!encoded.contains("SECRET"));
+        assert!(encoded.contains("apply_patch"));
+    }
+

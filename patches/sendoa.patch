new file mode 100644
index 0000000..f5aeb0b
--- /dev/null
+++ b/windows/src/views/task-history.ts
@@ -0,0 +1,51 @@
+import type { TaskHistoryEvent, TaskHistoryKind } from "../core/task-history";
+import { language, tl, N_ } from "../i18n/i18n";
+import { h, clear, svg } from "./dom";
+import { ICONS } from "./icons";
+
+const LABELS: Record<TaskHistoryKind, string> = {
+  tool_started: N_("Tool started"),
+  tool_finished: N_("Tool finished"),
+  permission_requested: N_("Permission requested"),
+  turn_finished: N_("Turn finished"),
+  turn_failed: N_("Turn failed"),
+  turn_cancelled: N_("Turn cancelled"),
+};
+const GLYPHS: Record<TaskHistoryKind, string> = {
+  tool_started: ICONS.play,
+  tool_finished: ICONS.doc,
+  permission_requested: ICONS.bang,
+  turn_finished: ICONS.bubble,
+  turn_failed: ICONS.octagonX,
+  turn_cancelled: ICONS.xmark,
+};
+
+/** Passive view: its owner selects the task and calls sync from the existing update path. */
+export function buildTaskHistory() {
+  const rows = h("ol", {
+    class: "int-rows", role: "list",
+    style: "list-style:none;margin:0;padding:5px 0 0;max-height:180px;overflow:auto",
+  });
+  const empty = h("p", { class: "int-empty", text: tl("Waiting for activity") });
+  const el = h("section", { class: "task-history", "aria-label": tl("History") },
+    h("div", { class: "int-head" }, h("b", { text: tl("History") })), rows, empty);
+
+  function sync(events: readonly TaskHistoryEvent[]) {
+    clear(rows);
+    empty.style.display = events.length ? "none" : "";
+    for (const event of events) {
+      const row = h("li", { class: "int-row" },
+        svg(GLYPHS[event.kind], 12, { evenOdd: event.kind === "turn_failed" }),
+        h("span", { class: "int-name", text: tl(LABELS[event.kind]) }));
+      if (event.timestamp !== undefined) {
+        const date = new Date(event.timestamp);
+        if (Number.isFinite(date.getTime())) row.append(h("time", {
+          class: "int-ago", datetime: date.toISOString(), title: date.toLocaleString(language()),
+          text: date.toLocaleTimeString(language(), { hour: "2-digit", minute: "2-digit", second: "2-digit" }),
+        }));
+      }
+      rows.append(row);
+    }
+  }
+  return { el, sync };
+}

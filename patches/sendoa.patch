+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { roomAgents, agentStatus } from '../src/core/agent-room.ts';
+import { State } from '../src/core/state.ts';
+import { setLanguage } from '../src/i18n/i18n.ts';
+const task=(id,state='idle',extra={})=>({id,name:id,color:'#b4ff39',state,source:'agent',isIntegration:true,steps:[],stepIndex:0,...extra});
+test('room excludes service and chat provider pills',()=>{
+ const tasks=[task('agent_codex','working'),task('integration_spotify'),task('integration_github'),task('custom','thinking',{isIntegration:false}),task('integration_claude')];
+ assert.deepEqual(roomAgents(tasks).map(t=>t.id),['agent_codex','custom','integration_claude']);
+ setLanguage('es');assert.match(agentStatus('working'),/Trabajando/);
+ assert.notEqual(agentStatus('question'),agentStatus('working'));
+});
+test('default opening preserves the usual overview and pending requests',()=>{
+ State.tasks=[task('agent_codex','working')]; State.focusId='agent_codex'; State.pendingApproval=null;
+ assert.equal(State.defaultView(),'overview');
+ State.pendingApproval={pillId:'agent_codex',requestId:'r',questions:[{}]};assert.equal(State.defaultView(),'question');
+ State.pendingApproval=null;State.tasks.push(task('integration_spotify'));State.focusId='integration_spotify';
+ assert.equal(State.defaultView(),'overview');State.tasks=[];assert.equal(State.defaultView(),'empty');
+});
+test('desks update live, use safe text and open details or questions',async()=>{
+ const {installFakeDom}=await import('./fakedom.mjs');installFakeDom();
+ const {buildAgentRoom}=await import('../src/views/agent-room.ts');
+ const selected=[],views=[];const room=buildAgentRoom({setFocus:id=>selected.push(id),setView:v=>views.push(v),blip(){}});
+ State.mode='expanded';State.view='agents';State.pendingApproval=null;
+ State.tasks=[task('agent_codex','working',{name:'Codex <script>',steps:['Editando <b>archivo</b>']})];State.focusId='agent_codex';room.sync();
+ assert.ok(room.el.textContent.includes('Codex <script>'));assert.ok(room.el.textContent.includes('Editando <b>archivo</b>'));
+ const desk=room.el.find('.agent-desk')[0];desk.fire('click');assert.deepEqual(selected,['agent_codex']);assert.deepEqual(views,['overview']);
+ State.tasks[0].state='question';State.pendingApproval={pillId:'agent_codex',requestId:'r',questions:[{}]};room.sync();
+ assert.ok(room.el.textContent.includes(agentStatus('question')));desk.fire('click');assert.equal(views.at(-1),'question');
+ State.mode='compact';room.sync();assert.equal(room.el.find('.agent-desk').length,0);
+ State.mode='expanded';room.sync();assert.equal(room.el.find('.agent-desk').length,1);
+ State.tasks=[];room.sync();assert.equal(room.el.find('.agent-desk').length,0);assert.ok(room.el.textContent.includes('Conecta'));
+});

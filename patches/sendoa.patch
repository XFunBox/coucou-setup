diff --git a/windows/tests/compact-clock.test.mjs b/windows/tests/compact-clock.test.mjs
new file mode 100644
index 0000000..ec1e14e
--- /dev/null
+++ b/windows/tests/compact-clock.test.mjs
@@ -0,0 +1,51 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { State } from '../src/core/state.ts';
+import { installFakeDom } from './fakedom.mjs';
+import { buildCompactClock } from '../src/island/compact.ts';
+import { Island } from '../src/island/island.ts';
+
+test('compact clock stays visible through agent completion and permission alerts', () => {
+  const mode = State.mode;
+  const showClock = State.settings.showClock;
+  const override = State.stateOverride;
+  const pending = State.pendingApproval;
+  installFakeDom();
+  const clock = buildCompactClock();
+  const host = { compactMusic: { visible: false }, compactClock: clock, compactStatus: { style: { display: 'none' } }, clockEl: clock.el };
+  const draw = () => Island.prototype.updateClock.call(host);
+  try {
+    State.mode = 'compact'; State.settings.showClock = true;
+    State.stateOverride = 'finished';
+    draw(); assert.equal(host.clockEl.style.opacity, '1');
+    State.stateOverride = 'approval'; State.pendingApproval = {};
+    draw(); assert.equal(host.clockEl.style.opacity, '1');
+    State.stateOverride = 'error'; State.pendingApproval = null;
+    draw(); assert.equal(host.clockEl.style.opacity, '1'); assert.ok(host.clockEl.textContent.length);
+    host.compactMusic.visible = true;
+    draw(); assert.equal(host.clockEl.style.opacity, '1', 'music keeps the clock visible');
+    assert.ok(host.clockEl.classList.contains('music-clock'));
+    host.compactMusic.visible = false;
+    draw(); assert.equal(host.clockEl.classList.contains('music-clock'), false);
+    host.compactStatus.style.display = 'block';
+    draw(); assert.equal(host.clockEl.style.visibility, 'hidden', 'status text keeps priority');
+    host.compactStatus.style.display = 'none';
+    State.settings.showClock = false;
+    draw(); assert.equal(host.clockEl.style.opacity, '0');
+    State.settings.showClock = true; State.mode = 'expanded';
+    draw(); assert.equal(host.clockEl.style.opacity, '0');
+  } finally {
+    State.mode = mode; State.settings.showClock = showClock; State.stateOverride = override; State.pendingApproval = pending;
+  }
+});
+
+ test('clock orbit follows minutes within the hour and resets across midnight', () => {
+  installFakeDom();
+  const clock = buildCompactClock();
+  clock.sync(new Date(2026, 9, 31, 23, 59, 59));
+  assert.equal(clock.el.style['--clock-orbit'], '354deg');
+  assert.match(clock.el.getAttribute('aria-label'), /Orbit|Órbita/);
+  clock.sync(new Date(2026, 10, 1, 0, 0));
+  assert.equal(clock.el.style['--clock-orbit'], '0deg');
+  assert.equal(clock.el.children[1].textContent, new Date(2026, 10, 1).toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' }));
+});
diff --git a/windows/tests/compact-music.test.mjs b/windows/tests/compact-music.test.mjs

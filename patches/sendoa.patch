+.agent-node-point { grid-column: 1; grid-row: 1 / span 3; width: 12px; height: 12px; border: 2px solid var(--agent-color, var(--eva-accent)); border-radius: 50%; background: var(--eva-panel); }
+.agent-node-name, .agent-node-status, .agent-node-activity { grid-column: 2; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 16px; }
+.agent-node-name { font-size: 11px; font-weight: 650; color: var(--eva-text); }
+.agent-node-status, .agent-node-activity { font-size: 10px; color: var(--eva-secondary); }

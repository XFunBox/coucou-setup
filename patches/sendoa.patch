+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyFlow, CodexFlow } from '../src/core/codex-flow.ts';
+import { State } from '../src/core/state.ts';
+import { roomAgents } from '../src/core/agent-room.ts';
+const agent=(id,parentId=null,status='working')=>({id,parentId,name:`/root/${id}`,role:parentId?'sendoa-tecnico':null,model:'gpt-6.1-sol',effort:'high',status,tool:'exec',lastSeen:'2026-10-21T06:00:00Z'});
+afterEach(()=>applyFlow(null));
+test('monitor shows actual tree instead of configured product pills',()=>{
+ applyFlow({rootId:'root',agents:[agent('root'),agent('child','root','completed')],truncated:false,warnings:[]});
+ const tasks=roomAgents([{id:'agent_codex'},{id:'agent_copilot'}]);
+ assert.deepEqual(tasks.map(t=>t.id),['agent_codex','codex_child_child']);
+ assert.equal(tasks[1].state,'finished');assert.equal(tasks[1].flow.parentId,'root');
+ applyFlow(null);assert.equal(CodexFlow.tasks.length,0);
+});
+test('new snapshot removes vanished children and preserves unknown status',()=>{
+ applyFlow({rootId:'new',agents:[agent('new',null,'unknown')],truncated:true,warnings:[]});
+ assert.equal(CodexFlow.tasks.length,1);assert.equal(CodexFlow.tasks[0].state,'idle');
+ assert.equal(CodexFlow.snapshot.truncated,true);
+});
+
+test('hook attention state stays visible over working flow metadata',()=>{
+ applyFlow({rootId:'root',agents:[agent('root')],truncated:false,warnings:[]});
+ for (const state of ['question','approval','ratelimit','error']) {
+  State.tasks=[{id:'agent_codex',state}]; State.focusId='agent_codex';
+  assert.equal(roomAgents(State.tasks)[0].state,state);
+  assert.equal(State.effectiveState,state);
+ }
+ State.tasks=[];
+});
+test('room clicks use current source and preserve pending questions',async()=>{
+ const {installFakeDom}=await import('./fakedom.mjs');installFakeDom();
+ const {buildAgentRoom}=await import('../src/views/agent-room.ts');
+ const views=[];const room=buildAgentRoom({setFocus(){},setView:v=>views.push(v),blip(){}});
+ State.mode='expanded';State.view='agents';State.pendingApproval=null;
+ State.tasks=[{id:'agent_codex',name:'Codex',color:'#b4ff39',state:'working',source:'agent',steps:[],stepIndex:0}];State.focusId='agent_codex';
+ applyFlow(null);room.sync();const desk=room.el.find('.agent-desk')[0];
+ applyFlow({rootId:'root',agents:[agent('root')],truncated:false,warnings:[]});room.sync();desk.fire('click');
+ assert.deepEqual(views,[]);
+ State.tasks[0].state='question';State.pendingApproval={pillId:'agent_codex',questions:[{}]};room.sync();desk.fire('click');
+ assert.equal(views.at(-1),'question');
+ applyFlow(null);State.pendingApproval=null;room.sync();desk.fire('click');assert.equal(views.at(-1),'overview');
+ State.tasks=[];State.pendingApproval=null;
+});
diff --git a/windows/tests/compact-clock.test.mjs b/windows/tests/compact-clock.test.mjs
new file mode 100644
index 0000000..e100838
--- /dev/null
+++ b/windows/tests/compact-clock.test.mjs
@@ -0,0 +1,23 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { State } from '../src/core/state.ts';
+import { Island } from '../src/island/island.ts';
+
+test('compact agent status takes priority over the optional clock, and the clock returns when free', () => {
+  const mode = State.mode;
+  const showClock = State.settings.showClock;
+  const host = { compactStatus: { style: { display: 'block' } }, clockEl: { style: {}, textContent: '' } };
+  const draw = () => Island.prototype.updateClock.call(host);
+  try {
+    State.mode = 'compact'; State.settings.showClock = true;
+    draw(); assert.equal(host.clockEl.style.opacity, '0');
+    host.compactStatus.style.display = 'none';
+    draw(); assert.equal(host.clockEl.style.opacity, '1'); assert.ok(host.clockEl.textContent.length);
+    State.settings.showClock = false;
+    draw(); assert.equal(host.clockEl.style.opacity, '0');
+    State.settings.showClock = true; State.mode = 'expanded';
+    draw(); assert.equal(host.clockEl.style.opacity, '0');
+  } finally {
+    State.mode = mode; State.settings.showClock = showClock;
+  }
+});

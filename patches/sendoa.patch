+        fn a_fallback_read_started_after_spotifast_disappears_wins_concurrent_getall() {
+            let _spotify = TestPlayer::start("org.mpris.MediaPlayer2.spotify", "fallback", "Spotify Fallback");
+            let spotifast = TestPlayer::start("org.mpris.MediaPlayer2.spotifast", "departed", "Departed EVA");
+            let (tx, _rx) = std::sync::mpsc::channel();
+            let out = Out::Test(tx);
+            let generation = {
+                let mut s = SHARED.lock().unwrap();
+                assert!(!s.active, "requires no listener from another test");
+                s.active = true;
+                s.generation += 1;
+                s.owner = None;
+                s.bus = BUS;
+                s.revision += 1;
+                s.state = PlayerState::default();
+                s.generation
+            };
+            struct ActiveCleanup(Out);
+            impl Drop for ActiveCleanup { fn drop(&mut self) { set_active(self.0.clone(), false); } }
+            let _cleanup = ActiveCleanup(out.clone());
+            let (a_entered, a_release) = spotifast.hold_next_get_all(true);
+            let a_out = out.clone();
+            let a = std::thread::spawn(move || {
+                let conn = Connection::new_session().unwrap();
+                read_everything(&conn, &a_out, generation)
+            });
+            // The server has released Spotifast's well-known name, while A's
+            // old GetAll response is held back on its still-connected unique name.
+            a_entered.recv_timeout(Duration::from_secs(3)).unwrap();
+            let (b_entered, b_release) = _spotify.hold_next_get_all(false);
+            let b_out = out.clone();
+            let b = std::thread::spawn(move || {
+                let conn = Connection::new_session().unwrap();
+                read_everything(&conn, &b_out, generation)
+            });
+            b_entered.recv_timeout(Duration::from_secs(3)).unwrap();
+            // Force the older completion to precede the later fallback completion.
+            a_release.send(()).unwrap();
+            a.join().unwrap();
+            b_release.send(()).unwrap();
+            b.join().unwrap();
+            let (state, bus) = {
+                let s = SHARED.lock().unwrap();
+                (s.state.clone(), s.bus)
+            };
+            assert_eq!(state.track.as_ref().unwrap().title, "Spotify Fallback");
+            assert_eq!(bus, "org.mpris.MediaPlayer2.spotify");
+            assert!(state.running);
+        }
+
+        struct GetAllBarrier { entered: std::sync::mpsc::Sender<()>, release: std::sync::mpsc::Receiver<()>, drop_name: bool }
+        enum TestSignal { Stale(std::sync::mpsc::Sender<()>), HoldGetAll(GetAllBarrier, std::sync::mpsc::Sender<()>), Stop }
+        struct TestPlayer {
+            calls: Arc<Mutex<Vec<String>>>,
+            tx: std::sync::mpsc::Sender<TestSignal>,
+            thread: Option<std::thread::JoinHandle<()>>,
+        }
+        impl TestPlayer {
+            fn start(bus: &'static str, id: &'static str, title: &'static str) -> Self {
+                let calls = Arc::new(Mutex::new(Vec::new()));
+                let (tx, rx) = std::sync::mpsc::channel();
+                let (ready_tx, ready_rx) = std::sync::mpsc::channel();
+                let recorded = calls.clone();
+                let thread = std::thread::spawn(move || {
+                    let conn = Connection::new_session().unwrap();
+                    conn.request_name(bus, false, true, true).unwrap();
+                    ready_tx.send(()).unwrap();
+                    let mut playing = true;
+                    let mut get_all_barrier: Option<GetAllBarrier> = None;
+                    let player = |playing: bool| {
+                        let mut meta: PropMap = HashMap::new();
+                        meta.insert("mpris:trackid".into(), var(dbus::Path::new(format!("/org/mpris/MediaPlayer2/Track/{id}")).unwrap()));
+                        meta.insert("mpris:length".into(), var(180_000_000i64));
+                        meta.insert("xesam:url".into(), var(format!("spotify:track:{id}")));
+                        meta.insert("mpris:artUrl".into(), var(format!("https://i.scdn.co/image/{id}")));
+                        meta.insert("xesam:title".into(), var(title.to_string()));
+                        meta.insert("xesam:artist".into(), var(vec!["EVA Artist".to_string()]));
+                        meta.insert("xesam:album".into(), var("EVA Album".to_string()));
+                        let mut props: PropMap = HashMap::new();
+                        props.insert("Metadata".into(), var(meta));
+                        props.insert("PlaybackStatus".into(), var(if playing { "Playing" } else { "Paused" }.to_string()));
+                        props.insert("Position".into(), var(31_000_000i64));
+                        props.insert("Volume".into(), var(0.8f64));
+                        props
+                    };
+                    loop {
+                        match rx.try_recv() {
+                            Ok(TestSignal::Stop) => break,
+                            Ok(TestSignal::HoldGetAll(barrier, ack)) => { get_all_barrier = Some(barrier); ack.send(()).unwrap(); },
+                            Ok(TestSignal::Stale(ack)) => {
+                                let mut changed: PropMap = HashMap::new();
+                                changed.insert("Metadata".into(), var({ let mut p: PropMap = HashMap::new(); p.insert("xesam:title".into(), var("Stale Song".to_string())); p.insert("mpris:trackid".into(), var(dbus::Path::new("/stale").unwrap())); p }));
+                                conn.channel().send(Message::new_signal(PATH, PROPERTIES, "PropertiesChanged").unwrap().append3(PLAYER, changed, Vec::<String>::new())).unwrap();
+                                conn.channel().send(Message::new_signal(PATH, PLAYER, "Seeked").unwrap().append1(99_000_000i64)).unwrap();
+                                conn.channel().flush(); ack.send(()).unwrap();
+                            }
+                            _ => {}
+                        }
+                        let Ok(Some(msg)) = conn.channel().blocking_pop_message(Duration::from_millis(20)) else { continue };
+                        if msg.msg_type() != MessageType::MethodCall { continue }
+                        let member = msg.member().unwrap().to_string();
+                        let record = match member.as_str() {
+                            "Get" | "Set" => { let (_, name): (String, String) = msg.read2().unwrap(); format!("{member} {name}") },
+                            "SetPosition" => { let (p,n): (dbus::Path,i64)=msg.read2().unwrap(); format!("SetPosition {p} {n}") },
+                            _ => member.clone(),
+                        };
+                        recorded.lock().unwrap().push(record);
+                        let reply = match member.as_str() {
+                            "GetAll" => {
+                                let props = player(playing);
+                                if let Some(barrier) = get_all_barrier.take() {
+                                    if barrier.drop_name { conn.release_name(bus).unwrap(); conn.channel().flush(); }
+                                    barrier.entered.send(()).unwrap();
+                                    barrier.release.recv_timeout(Duration::from_secs(5)).unwrap();
+                                }
+                                msg.method_return().append1(props)
+                            },
+                            "Get" => {
+                                let (_, name): (String, String)=msg.read2().unwrap();
+                                if name=="CanRaise" { msg.method_return().append1(var(true)) }
+                                else { msg.method_return().append1(var(value_box(&player(playing)[&name].0))) }
+                            },
+                            "PlayPause" => {
+                                playing=!playing;
+                                let mut changed: PropMap=HashMap::new(); changed.insert("PlaybackStatus".into(),var(if playing {"Playing"} else {"Paused"}.to_string()));
+                                conn.channel().send(Message::new_signal(PATH, PROPERTIES, "PropertiesChanged").unwrap().append3(PLAYER,changed,Vec::<String>::new())).unwrap();
+                                msg.method_return()
+                            },
+                            _ => msg.method_return(),
+                        };
+                        conn.channel().send(reply).unwrap(); conn.channel().flush();
+                    }
+                    conn.release_name(bus).unwrap(); conn.channel().flush();
+                });
+                ready_rx.recv_timeout(Duration::from_secs(3)).unwrap();
+                Self {calls, tx, thread: Some(thread)}
+            }
+            fn hold_next_get_all(&self, drop_name: bool) -> (std::sync::mpsc::Receiver<()>, std::sync::mpsc::Sender<()>) {
+                let (entered, observed) = std::sync::mpsc::channel();
+                let (release, released) = std::sync::mpsc::channel();
+                let (ack, ready) = std::sync::mpsc::channel();
+                self.tx.send(TestSignal::HoldGetAll(GetAllBarrier { entered, release: released, drop_name }, ack)).unwrap();
+                ready.recv_timeout(Duration::from_secs(3)).unwrap();
+                (observed, release)
+            }
+            fn send_stale(&self) { let(tx,rx)=std::sync::mpsc::channel(); self.tx.send(TestSignal::Stale(tx)).unwrap(); rx.recv_timeout(Duration::from_secs(3)).unwrap(); }
+            fn stop(&mut self) { if let Some(t)=self.thread.take() { let _=self.tx.send(TestSignal::Stop); t.join().unwrap(); } }
+        }
+        impl Drop for TestPlayer { fn drop(&mut self) { self.stop(); } }
+
         fn value_box(v: &Box<dyn RefArg>) -> Box<dyn RefArg> {
             v.box_clone()
         }

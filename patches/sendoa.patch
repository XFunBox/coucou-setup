+
+/* EVA agent room: hook-driven Mochis at individual desks. */
+.agent-room { padding: 0 16px 12px; display: flex; flex-direction: column; gap: 8px; }
+.room-heading { display: flex; align-items: center; justify-content: space-between; color: var(--eva-accent); font-size: 11px; font-weight: 700; letter-spacing: .08em; }
+.room-count { color: var(--eva-secondary); font-family: monospace; }
+.agent-room-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; overflow-y: auto; min-height: 0; flex: 1; align-content: start; padding: 2px; }
+.agent-desk { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 8px; border: 1px solid var(--eva-border); border-radius: 10px; background: linear-gradient(160deg, var(--eva-card), var(--eva-panel)); color: var(--eva-text); cursor: pointer; text-align: center; font: inherit; }
+.agent-desk:hover, .agent-desk:focus-visible { border-color: var(--eva-accent); outline: 2px solid var(--eva-accent); outline-offset: -2px; background: var(--eva-hover); }
+.agent-desk.selected { border-color: var(--eva-accent); }
+.desk-scene { display: block; position: relative; width: 100%; height: 106px; flex-shrink: 0; background: repeating-linear-gradient(0deg, transparent, transparent 15px, rgba(var(--eva-border-rgb), .12) 16px), repeating-linear-gradient(90deg, transparent, transparent 15px, rgba(var(--eva-border-rgb), .12) 16px); }
+.desk-monitor { position: absolute; width: 30px; height: 22px; left: calc(50% + 7px); top: 22px; border: 3px solid var(--eva-border); border-radius: 3px; background: var(--eva-bg); box-shadow: 0 0 12px rgba(var(--eva-accent-rgb), .09); }
+.desk-monitor::after { content: ''; display: block; margin: 4px; width: 12px; height: 2px; background: var(--eva-accent); box-shadow: 0 4px rgba(var(--eva-accent-rgb), .38); }
+.desk-surface { position: absolute; top: 56px; left: 16%; width: 68%; height: 7px; background: var(--eva-border); border-bottom: 3px solid var(--eva-hover); box-shadow: 0 13px 0 -2px var(--eva-hover); }
+.desk-worker { position: absolute; top: 57px; left: calc(50% - 32px); }
+.desk-name, .desk-status, .desk-step { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 17px; }
+.desk-name { font-size: 11px; font-weight: 650; }
+.desk-status { font-size: 10px; color: var(--eva-secondary); }
+.desk-step { font-size: 10px; color: var(--eva-secondary); }
+.agent-desk[data-state='working'] .desk-status, .agent-desk[data-state='finished'] .desk-status { color: var(--eva-accent); }
+.agent-desk[data-state='approval'] .desk-status, .agent-desk[data-state='question'] .desk-status, .agent-desk[data-state='ratelimit'] .desk-status { color: var(--eva-attention); }
+.agent-desk[data-state='error'] .desk-status { color: var(--eva-error); }
+.agent-desk[data-state='working'] .desk-monitor::after, .agent-desk[data-state='thinking'] .desk-monitor::after, .agent-desk[data-state='searching'] .desk-monitor::after { animation: desk-activity 1.4s steps(2, end) infinite; }
+.room-caption { font-size: 10px; color: var(--eva-secondary); }
+.room-empty { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--eva-secondary); font-size: 12px; }
+@keyframes desk-activity { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .agent-room * { animation: none !important; } }
+
+#compact-agent-status { position: absolute; top: 0; left: 64px; width: 164px; line-height: 32px; font-size: 10px; color: var(--eva-secondary); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; pointer-events: none; }
+
+.room-detail { white-space: pre-line; font-size: 11px; line-height: 18px; padding: 8px 12px; border-left: 2px solid var(--eva-accent); background: var(--eva-card); color: var(--eva-text); flex-shrink: 0; overflow-wrap: anywhere; }
+.agent-room-grid { background: repeating-linear-gradient(0deg, transparent, transparent 31px, rgba(var(--eva-border-rgb), .16) 32px), repeating-linear-gradient(90deg, transparent, transparent 31px, rgba(var(--eva-border-rgb), .16) 32px); border: 1px solid var(--eva-border); border-radius: 12px; padding: 14px; }
+@media (max-width: 650px) { .agent-room-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 6px; } }
diff --git a/windows/src/theme.css b/windows/src/theme.css
new file mode 100644
index 0000000..91a8088
--- /dev/null
+++ b/windows/src/theme.css
@@ -0,0 +1,60 @@
+/* EVA-01: shared semantic colours for every Coucou window. */
+:root {
+  color-scheme: dark;
+  --eva-bg: #0C0B12;
+  --eva-panel: #151020;
+  --eva-card: #241733;
+  --eva-hover: #39244F;
+  --eva-border: #62418A;
+  --eva-text: #EEEFF4;
+  --eva-secondary: #B8ABC9;
+  --eva-accent: #A4FF39;
+  --eva-on-accent: #0C0B12;
+  --eva-attention: #FFA34D;
+  --eva-error: #FF647C;
+  --eva-accent-rgb: 164, 255, 57;
+  --eva-attention-rgb: 255, 163, 77;
+  --eva-error-rgb: 255, 100, 124;
+  --eva-border-rgb: 98, 65, 138;
+  --eva-success-soft: rgba(var(--eva-accent-rgb), 0.12);
+  --eva-attention-soft: rgba(var(--eva-attention-rgb), 0.13);
+  --eva-error-soft: rgba(var(--eva-error-rgb), 0.14);
+  --eva-line: rgba(var(--eva-border-rgb), 0.6);
+
+  /* Existing component names remain aliases; module colours stay independent. */
+  --bg: var(--eva-bg);
+  --ink: var(--eva-text);
+  --ink-2: var(--eva-text);
+  --dim: var(--eva-secondary);
+  --dim-2: var(--eva-secondary);
+  --dim-3: var(--eva-secondary);
+  --dim-4: var(--eva-secondary);
+  --dim-5: var(--eva-secondary);
+  --card: var(--eva-card);
+  --card-flat: var(--eva-panel);
+  --tab-on: var(--eva-hover);
+  --hairline: var(--eva-line);
+  --red: var(--eva-error);
+  --red-text: var(--eva-error);
+  --green: var(--eva-accent);
+  --green-2: var(--eva-accent);
+  --amber: var(--eva-attention);
+}
+
+:where(button, a, input, select, textarea, [tabindex]):focus-visible {
+  outline: 2px solid var(--eva-accent);
+  outline-offset: 2px;
+}
+
+::selection {
+  background: var(--eva-accent);
+  color: var(--eva-on-accent);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
diff --git a/windows/src/views/agent-room.ts b/windows/src/views/agent-room.ts
new file mode 100644
index 0000000..fef268a
--- /dev/null
+++ b/windows/src/views/agent-room.ts
@@ -0,0 +1,84 @@
+import { h } from "./dom";
+import { CodexFlow } from "../core/codex-flow";
+import { State } from "../core/state";
+import { roomAgents, agentStatus } from "../core/agent-room";
+import { createMiniBot, pruneMiniBots } from "../mochi/minibots";
+import { t, tl } from "../i18n/i18n";
+import type { ViewActions, ViewHost } from "./views";
+
+/** A visual home for existing hook-driven agents, without a second state model. */
+export function buildAgentRoom(actions: Pick<ViewActions, "setFocus" | "setView" | "blip">): ViewHost {
+  const count = h("span", { class: "room-count" });
+  const grid = h("div", { class: "agent-room-grid" });
+  const empty = h("div", { class: "room-empty", text: tl("Connect an agent in Settings to see its activity here.") });
+  const detail = h("div", { class: "room-detail" });
+  const caption = h("div", { class: "room-caption" });
+  let selected: string | null = null;
+  const el = h("div", { class: "view agent-room" },
+    h("div", { class: "room-heading" }, h("span", { text: tl("Agent room") }), count), grid, empty, detail, caption);
+  let key = "";
+  let desks: { id: string; button: HTMLElement; name: HTMLElement; status: HTMLElement; step: HTMLElement }[] = [];
+  function clear() {
+    grid.replaceChildren(); desks = []; key = ""; pruneMiniBots();
+  }
+  // No extra canvases keep running after leaving the room or folding the notch.
+  State.subscribe(() => { if (State.view !== "agents" || State.mode !== "expanded") clear(); });
+  return { el, sync() {
+    if (State.mode !== "expanded" || State.view !== "agents") { clear(); return; }
+    const tasks = roomAgents(State.tasks);
+    const next = JSON.stringify(tasks.map(task => task.id));
+    if (key !== next) {
+      grid.replaceChildren(); desks = []; key = next;
+      for (const task of tasks) {
+        const name = h("span", { class: "desk-name" });
+        const status = h("span", { class: "desk-status" });
+        const step = h("span", { class: "desk-step" });
+        const button = h("button", { class: "agent-desk", onclick: () => {
+          actions.blip();
+          const current = roomAgents(State.tasks).find(item => item.id === task.id);
+          if (!current) return;
+          const request = State.pendingApproval;
+          if (request?.pillId === task.id) {
+            actions.setFocus(task.id);
+            actions.setView(request.questions ? "question" : "approval");
+            return;
+          }
+          if (current.flow) { selected = task.id; State.notify(); return; }
+          actions.setFocus(task.id);
+          actions.setView("overview");
+        } }, h("span", { class: "desk-scene", "aria-hidden": "true" },
+          h("span", { class: "desk-monitor" }), h("span", { class: "desk-surface" }),
+          h("span", { class: "desk-worker" }, createMiniBot(task, 38))), name, status, step);
+        grid.append(button); desks.push({ id: task.id, button, name, status, step });
+      }
+      pruneMiniBots();
+    }
+    const flow = tasks.some(task => task.flow);
+    const active = tasks.filter(task => task.state === "working").length;
+    count.textContent = flow ? `${active} activos · ${Math.max(0, tasks.length - 1)} subagentes` : String(tasks.length).padStart(2, "0");
+    caption.textContent = flow ? `Registros locales de Codex · chat ${CodexFlow.snapshot?.rootId?.slice(0, 8) ?? ""} · actualización cada 2,5 s${CodexFlow.snapshot?.truncated ? " · lectura parcial" : ""}` : CodexFlow.error ? "Monitor de Codex no disponible · actividad de hooks" : t("Live hook activity · Select a desk to see details");
+    const chosen = tasks.find(task => task.id === selected) ?? tasks[0];
+    detail.style.display = flow ? "" : "none";
+    if (chosen?.flow) {
+      const meta = chosen.flow;
+      const parent = tasks.find(task => task.flow?.id === meta.parentId);
+      const seen = meta.lastSeen ? new Date(meta.lastSeen) : null;
+      const stamp = seen && Number.isFinite(seen.getTime()) ? seen.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : "sin fecha";
+      detail.textContent = `${chosen.name} · ${meta.role || "agente principal"} · ${meta.model || "modelo no registrado"}${meta.effort ? ` / ${meta.effort}` : ""}\n${parent ? `Depende de ${parent.name} · ` : "Coordina el flujo · "}${meta.tool ? `Última herramienta: ${meta.tool} · ` : ""}Último registro: ${stamp}`;
+    }
+    empty.style.display = tasks.length ? "none" : "";
+    for (let i = 0; i < tasks.length; i++) {
+      const task = tasks[i], desk = desks[i];
+      const stale = task.flow?.status === "working" && (!task.flow.lastSeen || Date.now() - Date.parse(task.flow.lastSeen) > 90_000);
+      const alert = ["question", "approval", "ratelimit", "error"].includes(task.state) && task.state !== (task.flow?.status === "interrupted" ? "error" : "");
+      const status = alert ? agentStatus(task.state) : stale ? "◌ Sin actividad reciente" : task.flow?.status === "unknown" ? "○ Estado no registrado" : task.flow?.status === "interrupted" ? "Ⅱ Interrumpido" : agentStatus(task.state);
+      const activity = task.flow ? [task.flow.role || (task.flow.parentId ? "subagente" : "coordinador"), task.flow.tool].filter(Boolean).join(" · ") : task.finalLine || task.steps.at(-1) || t("Waiting for activity");
+      desk.name.textContent = task.name; desk.status.textContent = status; desk.step.textContent = activity;
+      desk.button.dataset.state = task.state;
+      desk.button.classList.toggle("selected", task.id === (flow ? chosen?.id : State.focusId));
+      desk.button.setAttribute("aria-label", `${task.name}: ${status}. ${activity}`);
+      desk.button.title = `${task.name} — ${status}\n${activity}`;
+      desk.button.style.setProperty("--agent-color", task.color);
+    }
+  } };
+}

@@ -0,0 +1,60 @@
+/* EVA-01: shared semantic colours for every Coucou window. */
+:root {
+  color-scheme: dark;
+  --eva-bg: #0C0B12;
+  --eva-panel: #151020;
+  --eva-card: #241733;
+  --eva-hover: #39244F;
+  --eva-border: #62418A;
+  --eva-text: #EEEFF4;
+  --eva-secondary: #B8ABC9;
+  --eva-accent: #A4FF39;
+  --eva-on-accent: #0C0B12;
+  --eva-attention: #FFA34D;
+  --eva-error: #FF647C;
+  --eva-accent-rgb: 164, 255, 57;
+  --eva-attention-rgb: 255, 163, 77;
+  --eva-error-rgb: 255, 100, 124;
+  --eva-border-rgb: 98, 65, 138;
+  --eva-success-soft: rgba(var(--eva-accent-rgb), 0.12);
+  --eva-attention-soft: rgba(var(--eva-attention-rgb), 0.13);
+  --eva-error-soft: rgba(var(--eva-error-rgb), 0.14);
+  --eva-line: rgba(var(--eva-border-rgb), 0.6);
+
+  /* Existing component names remain aliases; module colours stay independent. */
+  --bg: var(--eva-bg);
+  --ink: var(--eva-text);
+  --ink-2: var(--eva-text);
+  --dim: var(--eva-secondary);
+  --dim-2: var(--eva-secondary);
+  --dim-3: var(--eva-secondary);
+  --dim-4: var(--eva-secondary);
+  --dim-5: var(--eva-secondary);
+  --card: var(--eva-card);
+  --card-flat: var(--eva-panel);
+  --tab-on: var(--eva-hover);
+  --hairline: var(--eva-line);
+  --red: var(--eva-error);
+  --red-text: var(--eva-error);
+  --green: var(--eva-accent);
+  --green-2: var(--eva-accent);
+  --amber: var(--eva-attention);
+}
+
+:where(button, a, input, select, textarea, [tabindex]):focus-visible {
+  outline: 2px solid var(--eva-accent);
+  outline-offset: 2px;
+}
+
+::selection {
+  background: var(--eva-accent);
+  color: var(--eva-on-accent);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
diff --git a/windows/src/views/agent-room.ts b/windows/src/views/agent-room.ts
new file mode 100644
index 0000000..a058592
--- /dev/null
+++ b/windows/src/views/agent-room.ts
@@ -0,0 +1,146 @@
+import { h, clear } from "./dom";
+import { CodexFlow } from "../core/codex-flow";
+import { State, type AgentTask } from "../core/state";
+import { roomAgents, agentStatus } from "../core/agent-room";
+import { t, tl } from "../i18n/i18n";
+import type { ViewActions, ViewHost } from "./views";
+
+export const ROOM_NODE_LIMIT = 6;
+const SLOTS = [[50, 16], [82, 34], [82, 72], [50, 84], [18, 72], [18, 34]];
+let selectedAgentId: string | null = null;
+
+/** UI selection for notices targeting a flow child, which is not a configured pill. */
+export function selectRoomAgent(id: string): boolean {
+  if (!roomAgents(State.tasks).some(task => task.id === id)) return false;
+  selectedAgentId = id;
+  State.notify();
+  return true;
+}
+
+function statusFor(task: AgentTask): string {
+  const seen = Date.parse(task.flow?.lastSeen ?? "");
+  const stale = task.flow?.status === "working" && Number.isFinite(seen) && Date.now() - seen > 90_000;
+  const alert = ["question", "approval", "ratelimit", "error"].includes(task.state)
+    && !(task.flow?.status === "interrupted" && task.state === "error");
+  return alert ? agentStatus(task.state) : stale ? "◌ Sin actividad reciente"
+    : task.flow?.status === "unknown" ? "○ Estado no registrado"
+    : task.flow?.status === "interrupted" ? "Ⅱ Interrumpido" : agentStatus(task.state);
+}
+
+/** Real room agents, stable slots and confirmed relationships; no simulation or polling. */
+export function buildAgentRoom(actions: Pick<ViewActions, "setFocus" | "setView" | "blip">): ViewHost {
+  const count = h("span", { class: "room-count" });
+  const edges = document.createElementNS("http://www.w3.org/2000/svg", "svg");
+  edges.setAttribute("class", "constellation-edges");
+  edges.setAttribute("viewBox", "0 0 100 100");
+  edges.setAttribute("preserveAspectRatio", "none");
+  edges.setAttribute("aria-hidden", "true");
+  const grid = h("div", { class: "agent-room-grid agent-constellation", role: "group", "aria-label": tl("Agents") }, edges);
+  const empty = h("div", { class: "room-empty", text: tl("Connect an agent in Settings to see its activity here.") });
+  const detail = h("div", { class: "room-detail" });
+  const caption = h("div", { class: "room-caption" });
+  const overflow = h("div", { class: "agent-overflow-list", id: "agent-room-more", role: "group", "aria-label": tl("More agents") });
+  overflow.hidden = true;
+  const more = h("button", { class: "agent-overflow-toggle", type: "button", "aria-controls": "agent-room-more", "aria-expanded": "false" });
+  function closeOverflow() { overflow.hidden = true; more.setAttribute("aria-expanded", "false"); }
+  more.addEventListener("click", () => {
+    overflow.hidden = !overflow.hidden;
+    more.setAttribute("aria-expanded", String(!overflow.hidden));
+  });
+  overflow.addEventListener("keydown", event => {
+    if (event.key !== "Escape") return;
+    event.preventDefault(); event.stopPropagation(); closeOverflow(); more.focus();
+  });
+  const el = h("div", { class: "view agent-room" },
+    h("div", { class: "room-heading" }, h("span", { text: tl("Agent room") }), count), grid, empty, more, overflow, detail, caption);
+  const nodes = new Map<string, { button: HTMLElement; name: HTMLElement; status: HTMLElement; step: HTMLElement }>();
+  const slots: (string | null)[] = Array(ROOM_NODE_LIMIT).fill(null);
+
+  function activate(id: string) {
+    const current = roomAgents(State.tasks).find(task => task.id === id);
+    if (!current) return;
+    actions.blip();
+    const request = State.pendingApproval;
+    if (request?.pillId === id) {
+      actions.setFocus(id); actions.setView(request.questions ? "question" : "approval");
+    } else if (current.flow) selectRoomAgent(id);
+    else { actions.setFocus(id); actions.setView("overview"); }
+  }
+
+  return { el, sync() {
+    const shown = State.mode === "expanded" && State.view === "agents";
+    const tasks = new Map((shown ? roomAgents(State.tasks) : []).map(task => [task.id, task]));
+    // Keep both DOM identity and the occupied slot when a snapshot is reordered.
+    for (const [id, node] of nodes) if (!tasks.has(id)) {
+      node.button.remove(); nodes.delete(id);
+      const slot = slots.indexOf(id); if (slot !== -1) slots[slot] = null;
+    }
+    for (const id of tasks.keys()) if (!nodes.has(id)) {
+      const name = h("span", { class: "agent-node-name" });
+      const status = h("span", { class: "agent-node-status" });
+      const step = h("span", { class: "agent-node-activity" });
+      const button = h("button", { class: "agent-node agent-desk", type: "button", onclick: () => activate(id) },
+        h("span", { class: "agent-node-point", "aria-hidden": "true" }), name, status, step);
+      button.dataset.agentId = id;
+      nodes.set(id, { button, name, status, step });
+    }
+    for (const id of nodes.keys()) if (!slots.includes(id)) {
+      const slot = slots.indexOf(null); if (slot !== -1) slots[slot] = id;
+    }
+    const all = [...tasks.values()];
+    const chosen = tasks.get(selectedAgentId ?? "") ?? tasks.get(State.focusId ?? "") ?? all[0];
+    selectedAgentId = chosen?.id ?? null;
+    for (const [id, node] of nodes) {
+      const task = tasks.get(id)!;
+      const slot = slots.indexOf(id);
+      const host = slot === -1 ? overflow : grid;
+      if (node.button.parentNode !== host) host.append(node.button);
+      node.button.classList.toggle("constellation-node", slot !== -1);
+      node.button.classList.toggle("agent-overflow-item", slot === -1);
+      if (slot !== -1) {
+        node.button.style.setProperty("--node-x", `${SLOTS[slot][0]}%`);
+        node.button.style.setProperty("--node-y", `${SLOTS[slot][1]}%`);
+      }
+      const status = statusFor(task);
+      const activity = task.flow ? [task.flow.role, task.flow.tool].filter(Boolean).join(" · ") || t("Waiting for activity")
+        : task.finalLine || task.steps.at(-1) || t("Waiting for activity");
+      node.name.textContent = task.name; node.status.textContent = status; node.step.textContent = activity;
+      node.button.dataset.state = task.state;
+      node.button.classList.toggle("selected", id === chosen?.id);
+      node.button.setAttribute("aria-pressed", String(id === chosen?.id));
+      node.button.setAttribute("aria-label", `${task.name}: ${status}. ${activity}`);
+      node.button.title = `${task.name} — ${status}\n${activity}`;
+      node.button.style.setProperty("--agent-color", task.color);
+    }
+
+    clear(edges);
+    for (const child of all) {
+      const parent = child.flow?.parentId ? all.find(task => task.flow?.id === child.flow!.parentId) : undefined;
+      if (!parent || parent.id === child.id) continue;
+      const from = slots.indexOf(parent.id), to = slots.indexOf(child.id);
+      if (from === -1 || to === -1) continue;
+      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
+      for (const [key, value] of Object.entries({ x1: SLOTS[from][0], y1: SLOTS[from][1], x2: SLOTS[to][0], y2: SLOTS[to][1], "data-parent": parent.id, "data-child": child.id })) line.setAttribute(key, String(value));
+      edges.append(line);
+    }
+    const hidden = all.length - slots.filter(id => id !== null).length;
+    more.hidden = hidden === 0;
+    more.textContent = `+${hidden}`;
+    more.setAttribute("aria-label", t("Show {count} more agents", { count: hidden }));
+    if (!hidden || !shown) closeOverflow();
+    grid.hidden = all.length === 0;
+    empty.style.display = all.length ? "none" : "";
+    const flow = all.some(task => task.flow);
+    count.textContent = flow ? `${all.filter(task => task.state === "working").length} activos · ${all.filter(task => task.flow && task.flow.id !== CodexFlow.snapshot?.rootId).length} subagentes` : String(all.length).padStart(2, "0");
+    caption.textContent = !shown ? "" : flow ? `Registros locales de Codex · chat ${CodexFlow.snapshot?.rootId?.slice(0, 8) ?? ""}${CodexFlow.snapshot?.truncated ? " · lectura parcial" : ""}` : CodexFlow.error ? "Monitor de Codex no disponible · actividad de hooks" : t("Live hook activity · Select an agent to see details");
+    detail.style.display = chosen?.flow ? "" : "none";
+    detail.textContent = "";
+    if (chosen?.flow) {
+      const meta = chosen.flow;
+      const parent = all.find(task => task.id !== chosen.id && task.flow?.id === meta.parentId);
+      const seen = meta.lastSeen ? new Date(meta.lastSeen) : null;
+      const stamp = seen && Number.isFinite(seen.getTime()) ? seen.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : "sin fecha";
+      detail.textContent = `${chosen.name}${meta.role ? ` · ${meta.role}` : ""} · ${meta.model || "modelo no registrado"}${meta.effort ? ` / ${meta.effort}` : ""}\n${parent ? `Depende de ${parent.name} · ` : ""}${meta.tool ? `Última herramienta: ${meta.tool} · ` : ""}Último registro: ${stamp}`;
+    }
+  } };
+}

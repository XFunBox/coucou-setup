diff --git a/windows/src/island/notice.ts b/windows/src/island/notice.ts
new file mode 100644
index 0000000..e1a9d4a
--- /dev/null
+++ b/windows/src/island/notice.ts
@@ -0,0 +1,56 @@
+import type { AgentTask, ApprovalInfo } from "../core/state";
+import type { BotStateName } from "../core/layout";
+import { agentStatus } from "../core/agent-room";
+import { h } from "../views/dom";
+
+export interface CompactNotice {
+  pillId: string;
+  name: string;
+  state: BotStateName;
+  requestId?: string;
+  count: number;
+}
+const PRIORITY: Partial<Record<BotStateName, number>> = {
+  approval: 0, question: 0, ratelimit: 1, error: 1, finished: 2, dizzy: 3,
+};
+/** Derive notices from the existing tasks; no second queue can consume a request. */
+export function selectCompactNotice(tasks: AgentTask[], pending: ApprovalInfo | null): CompactNotice | null {
+  const items = new Map<string, CompactNotice>();
+  if (pending) items.set(pending.pillId, {
+    pillId: pending.pillId, name: tasks.find(task => task.id === pending.pillId)?.name ?? pending.tool,
+    state: pending.questions ? "question" : "approval", requestId: pending.requestId, count: 0,
+  });
+  for (const task of tasks) {
+    if (task.flow?.status === "interrupted" && task.state === "error") continue;
+    if (task.flow && task.state === "finished") {
+      const age = Date.now() - Date.parse(task.flow.lastSeen ?? "");
+      if (!Number.isFinite(age) || age < 0 || age > 5200) continue;
+    }
+    if (PRIORITY[task.state] == null || items.has(task.id)) continue;
+    items.set(task.id, {pillId: task.id, name: task.name, state: task.state, count: 0});
+  }
+  const selected = [...items.values()].sort((a, b) => (a.requestId != null ? -1 : PRIORITY[a.state]!) -
+    (b.requestId != null ? -1 : PRIORITY[b.state]!))[0];
+  return selected ? {...selected, count: items.size} : null;
+}
+
+export function buildCompactNotice(open: (notice: CompactNotice) => void) {
+  let current: CompactNotice | null = null;
+  const name = h("span", {class: "compact-notice-name"});
+  const status = h("span", {class: "compact-notice-status"});
+  const el = h("button", {id: "compact-notice", type: "button",
+    onmousedown: (event: Event) => event.stopPropagation(),
+    onclick: (event: Event) => { event.stopPropagation(); if (current) open(current); },
+  }, name, status);
+  return {el, sync(notice: CompactNotice | null) {
+    current = notice;
+    el.style.display = notice ? "flex" : "none";
+    if (!notice) return;
+    const label = agentStatus(notice.state);
+    name.textContent = notice.name;
+    status.textContent = `${label}${notice.count > 1 ? ` · +${notice.count - 1}` : ""}`;
+    el.dataset.state = notice.state;
+    el.title = `${notice.name}: ${status.textContent}`;
+    el.setAttribute("aria-label", el.title);
+  }};
+}

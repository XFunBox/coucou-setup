@@ -0,0 +1,135 @@
+import { describe, beforeEach, afterEach, test } from "node:test";
+import assert from "node:assert/strict";
+import { installFakeDom } from "./fakedom.mjs";
+import { State } from "../src/core/state.ts";
+import { applyFlow } from "../src/core/codex-flow.ts";
+import { setLanguage } from "../src/i18n/i18n.ts";
+import { buildAgentRoom, ROOM_NODE_LIMIT, selectRoomAgent } from "../src/views/agent-room.ts";
+
+const task = (id, over = {}) => ({ id, name: id, color: "#b4ff39", state: "working", source: "agent", isIntegration: false, steps: [], stepIndex: 0, ...over });
+const agent = (id, parentId = null, over = {}) => ({ id, parentId, name: id, role: null, model: null, effort: null, status: "working", tool: null, lastSeen: null, ...over });
+const nodes = room => room.el.find(".constellation-node");
+const node = (room, id) => room.el.find(".agent-node").find(item => item.dataset.agentId === id);
+function build() {
+  const focus = [], views = [];
+  const room = buildAgentRoom({ setFocus: id => focus.push(id), setView: view => views.push(view), blip() {} });
+  return { room, focus, views };
+}
+function flow(agents) {
+  State.tasks = [task("agent_codex")];
+  applyFlow({ rootId: "root", agents, warnings: [], truncated: false });
+}
+describe("agent constellation", () => {
+beforeEach(() => {
+  installFakeDom(); setLanguage("en"); applyFlow(null);
+  State.mode = "expanded"; State.view = "agents"; State.tasks = [];
+  State.focusId = ""; State.pendingApproval = null;
+});
+afterEach(() => { applyFlow(null); State.tasks = []; State.pendingApproval = null; });
+
+test("the constellation contains only room agents, deduplicates identities and creates no canvases", () => {
+  State.tasks = [task("real", { name: "Agent <b>real</b>" }), task("real"), task("integration_spotify", { isIntegration: true })];
+  const { room } = build(); room.sync();
+  assert.equal(nodes(room).length, 1);
+  assert.equal(nodes(room)[0].tagName, "BUTTON");
+  assert.equal(nodes(room)[0].getAttribute("type"), "button");
+  assert.equal(room.el.find("CANVAS").length, 0);
+  assert.equal(room.el.find(".desk-scene").length, 0);
+  assert.equal(room.el.find("LINE").length, 0);
+});
+
+test("refreshes retain the DOM and slot of each agent despite reordered snapshots or removals", () => {
+  State.tasks = [task("a"), task("b"), task("c")];
+  const { room } = build(); room.sync();
+  const b = node(room, "b"), x = b.style["--node-x"], y = b.style["--node-y"];
+  State.tasks = [task("c"), task("a"), task("b", { state: "question" })]; room.sync();
+  assert.equal(node(room, "b"), b);
+  assert.deepEqual([b.style["--node-x"], b.style["--node-y"]], [x, y]);
+  assert.equal(b.dataset.state, "question");
+  State.tasks = [task("b"), task("d"), task("c")]; room.sync();
+  assert.equal(node(room, "b"), b);
+  assert.deepEqual([b.style["--node-x"], b.style["--node-y"]], [x, y]);
+  assert.equal(nodes(room).length, 3);
+});
+
+test("only confirmed visible parent IDs produce edges; absent and self parents produce none", () => {
+  flow([agent("root"), agent("child", "root"), agent("orphan", "missing"), agent("self", "self")]);
+  const { room } = build(); room.sync();
+  const edges = room.el.find("LINE");
+  assert.equal(edges.length, 1);
+  assert.equal(edges[0].getAttribute("data-parent"), "agent_codex");
+  assert.equal(edges[0].getAttribute("data-child"), "codex_child_child");
+  selectRoomAgent("codex_child_orphan"); room.sync();
+  assert.doesNotMatch(room.el.find(".room-detail")[0].textContent, /Coordina el flujo|agente principal|Depende de/);
+});
+
+test("mixed hook agents do not become Codex subagents and missing parents do not hide observed flow children", () => {
+  flow([agent("root"), agent("child", "root"), agent("without-parent")]);
+  State.tasks.push(task("claude", { name: "Claude" }));
+  const { room, focus, views } = build(); room.sync();
+  assert.equal(nodes(room).length, 4);
+  assert.match(room.el.find(".room-count")[0].textContent, /2 subagentes/);
+  node(room, "claude").fire("click");
+  assert.equal(focus.at(-1), "claude"); assert.equal(views.at(-1), "overview");
+});
+
+test("the visible limit exposes every remaining agent through an accessible +N disclosure", () => {
+  State.tasks = Array.from({ length: ROOM_NODE_LIMIT + 3 }, (_, i) => task(`agent-${i}`));
+  const { room, focus, views } = build(); room.sync();
+  assert.equal(ROOM_NODE_LIMIT, 6);
+  assert.equal(nodes(room).length, ROOM_NODE_LIMIT);
+  const more = room.el.find(".agent-overflow-toggle")[0];
+  const list = room.el.find(".agent-overflow-list")[0];
+  assert.equal(more.textContent, "+3");
+  assert.equal(more.getAttribute("aria-expanded"), "false");
+  assert.equal(more.getAttribute("aria-controls"), list.getAttribute("id"));
+  assert.equal(list.hidden, true);
+  more.fire("click");
+  assert.equal(more.getAttribute("aria-expanded"), "true");
+  assert.equal(list.hidden, false);
+  assert.equal(room.el.find(".agent-overflow-item").length, 3);
+  node(room, "agent-8").fire("click");
+  assert.equal(focus.at(-1), "agent-8"); assert.equal(views.at(-1), "overview");
+  let focused = false; more.focus = () => { focused = true; };
+  const escape = { key: "Escape", preventDefault() {}, stopPropagation() {} };
+  for (const listener of list.listeners.get("keydown") ?? []) listener(escape);
+  assert.equal(list.hidden, true); assert.equal(focused, true);
+});
+
+test("a notice can select an exact overflow child without changing the visible slots", () => {
+  flow([agent("root"), ...Array.from({ length: ROOM_NODE_LIMIT + 1 }, (_, i) => agent(`child-${i}`, "root"))]);
+  const { room } = build(); room.sync();
+  const first = nodes(room)[0];
+  assert.equal(selectRoomAgent("codex_child_child-6"), true); room.sync();
+  assert.equal(nodes(room)[0], first);
+  assert.equal(node(room, "codex_child_child-6").getAttribute("aria-pressed"), "true");
+  assert.ok(room.el.find(".room-detail")[0].textContent.includes("child-6"));
+  assert.equal(selectRoomAgent("missing"), false);
+});
+
+test("current permissions take priority over the agent detail and disappeared identities cannot navigate", () => {
+  flow([agent("root"), agent("child", "root")]);
+  const { room, focus, views } = build(); room.sync();
+  const root = node(room, "agent_codex"), child = node(room, "codex_child_child");
+  State.pendingApproval = { pillId: "agent_codex", requestId: "r", questions: [{}] };
+  root.fire("click");
+  assert.equal(focus.at(-1), "agent_codex"); assert.equal(views.at(-1), "question");
+  State.pendingApproval = null; child.fire("click"); room.sync();
+  assert.ok(room.el.find(".room-detail")[0].textContent.includes("child"));
+  const previous = views.length;
+  flow([agent("root")]); room.sync(); child.fire("click");
+  assert.equal(views.length, previous);
+  assert.equal(node(room, "codex_child_child"), undefined);
+});
+
+test("disconnecting or folding clears nodes, edges, disclosure and old details", () => {
+  flow([agent("root"), agent("child", "root")]);
+  const { room } = build(); room.sync();
+  applyFlow(null); State.tasks = []; room.sync();
+  assert.equal(nodes(room).length, 0); assert.equal(room.el.find("LINE").length, 0);
+  assert.equal(room.el.find(".room-detail")[0].textContent, "");
+  assert.equal(room.el.find(".agent-overflow-toggle")[0].hidden, true);

+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { State } from '../src/core/state.ts';
+import { Island } from '../src/island/island.ts';
+
+test('live border reflects all agents and prioritizes unanswered requests over activity', () => {
+  const saved = { tasks: State.tasks, pendingApproval: State.pendingApproval, mode: State.mode,
+    paused: State.paused, stateOverride: State.stateOverride };
+  const host = { islandEl: { dataset: {} } };
+  const task = (id, state) => ({ id, state, name: id, isIntegration: false, source: 'agent' });
+  const draw = () => { Island.prototype.syncBorder.call(host); return host.islandEl.dataset.liveBorder; };
+  try {
+    State.mode = 'compact'; State.paused = false; State.stateOverride = null; State.pendingApproval = null;
+    State.tasks = [task('one', 'idle'), task('two', 'working')];
+    assert.equal(draw(), 'working');
+    State.tasks[0].state = 'error'; assert.equal(draw(), 'error');
+    State.tasks[1].state = 'question'; assert.equal(draw(), 'attention');
+    State.tasks = [task('one', 'working')]; State.pendingApproval = { requestId: 'pending' };
+    assert.equal(draw(), 'attention');
+    State.pendingApproval = null; State.tasks = [task('one', 'ratelimit')];
+    assert.equal(draw(), 'attention');
+    State.tasks = [task('one', 'thinking')]; assert.equal(draw(), 'working');
+    State.tasks[0].state = 'searching'; assert.equal(draw(), 'working');
+    State.tasks[0].state = 'finished'; assert.equal(draw(), 'finished');
+    State.tasks[0].state = 'idle'; assert.equal(draw(), 'idle');
+    State.stateOverride = 'error'; assert.equal(draw(), 'error');
+    State.paused = true; assert.equal(draw(), 'hidden');
+    State.paused = false; State.mode = 'hidden'; assert.equal(draw(), 'hidden');
+    State.stateOverride = null; State.mode = 'expanded'; State.tasks = [];
+    assert.equal(draw(), 'idle');
+  } finally { Object.assign(State, saved); }
+});

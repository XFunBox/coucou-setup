+//! Local Codex desktop follower. This private protocol may change with Codex.
+//! No rollout/credential access, payload logging, approvals, or send retries.
+use serde::Serialize;
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::PathBuf;
+
+const MAX_FRAME: usize = 16 * 1024 * 1024;
+const MAX_INDEX: u64 = 2 * 1024 * 1024;
+const MAX_QUERY: usize = 32 * 1024;
+const UNAVAILABLE: &str = "No se pudo conectar con el chat de Codex. Abre Codex y vuelve a intentarlo.";
+
+#[derive(Serialize, Debug)]
+pub struct Thread { pub id: String, pub title: String }
+#[derive(Serialize, Debug, PartialEq)]
+pub struct Message { pub role: &'static str, pub content: String }
+#[derive(Serialize, Debug)]
+#[serde(rename_all = "camelCase")]
+pub struct Snapshot {
+    pub thread_id: String,
+    pub messages: Vec<Message>,
+    pub active: bool,
+    pub active_turn_id: Option<String>,
+    pub pending: bool,
+    pub truncated: bool,
+}
+
+pub fn validate_thread(id: &str) -> Result<(), String> {
+    if id.len() == 36 && id.bytes().enumerate().all(|(i, c)| {
+        if [8, 13, 18, 23].contains(&i) { c == b'-' } else { c.is_ascii_hexdigit() }
+    }) { Ok(()) } else { Err("Identificador de chat inválido.".into()) }
+}
+
+fn codex_home() -> Result<PathBuf, String> {
+    let path = if let Some(value) = std::env::var_os("CODEX_HOME").filter(|v| !v.is_empty()) {
+        PathBuf::from(value)
+    } else {
+        PathBuf::from(std::env::var_os("HOME").filter(|v| !v.is_empty()).ok_or_else(|| UNAVAILABLE.to_owned())?).join(".codex")
+    };
+    if !path.is_absolute() { return Err("CODEX_HOME debe ser una ruta absoluta.".into()); }
+    Ok(path)
+}
+
+/// Only bounded metadata from the native selector index, never conversation files.
+pub fn threads() -> Result<Vec<Thread>, String> {
+    let path = codex_home()?.join("session_index.jsonl");
+    let meta = match std::fs::symlink_metadata(&path) {
+        Ok(m) if m.is_file() && !m.file_type().is_symlink() => m,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(vec![]),
+        _ => return Err("No se pudo leer el índice de chats de Codex.".into()),
+    };
+    let mut file = std::fs::File::open(path).map_err(|_| UNAVAILABLE.to_owned())?;
+    let start = meta.len().saturating_sub(MAX_INDEX);
+    file.seek(SeekFrom::Start(start)).map_err(|_| UNAVAILABLE.to_owned())?;
+    let mut bytes = Vec::new();
+    file.take(MAX_INDEX).read_to_end(&mut bytes).map_err(|_| UNAVAILABLE.to_owned())?;
+    Ok(parse_index(&bytes, start != 0))
+}
+
+fn parse_index(bytes: &[u8], partial: bool) -> Vec<Thread> {
+    let mut entries = HashMap::new();
+    for (n, line) in bytes.split(|b| *b == b'\n').enumerate() {
+        if (partial && n == 0) || line.len() > 16 * 1024 { continue; }
+        let Ok(v) = serde_json::from_slice::<Value>(line) else { continue };
+        let (Some(id), Some(title)) = (v["id"].as_str(), v["thread_name"].as_str()) else { continue };
+        if validate_thread(id).is_err() { continue; }
+        let title: String = title.chars().filter(|c| !c.is_control()).take(200).collect();
+        if title.trim().is_empty() { continue; }
+        entries.insert(id.to_owned(), (title, v["updated_at"].as_str().unwrap_or("").to_owned()));
+    }
+    let mut result: Vec<_> = entries.into_iter().collect();
+    result.sort_by(|a, b| b.1.1.cmp(&a.1.1).then_with(|| a.0.cmp(&b.0)));
+    // Codex also indexes internal guardian jobs under this reserved title.
+    // The index has no source field: exclude the known internal label only,
+    // after deduplication and before the visible-chat limit.
+    result.into_iter().filter(|(_, (title, _))| !title.trim().eq_ignore_ascii_case("Guardian review"))
+        .take(100).map(|(id, (title, _))| Thread { id, title }).collect()
+}
+
+fn text_input(value: &Value) -> String {
+    value.as_array().into_iter().flatten().filter(|v| v["type"] == "text")
+        .filter_map(|v| v["text"].as_str()).collect::<Vec<_>>().join("\n")
+}
+
+fn turn_key(turn: &Value) -> Option<&str> {
+    turn["turnId"].as_str().or_else(|| turn["params"]["clientUserMessageId"].as_str())
+}
+
+fn normalize(thread: &str, state: &Value) -> Snapshot {
+    let canonical = state["turnHistory"]["kind"] == "canonical";
+    let history = &state["turnHistory"]["history"];
+    let mut truncated = canonical && history["isComplete"] != true;
+    let mut turns: Vec<Value> = vec![];
+    if canonical {
+        for island in history["islands"].as_array().into_iter().flatten() {
+            for entry in island["entries"].as_array().into_iter().flatten() {
+                if let Some(key) = entry["value"].as_str() {
+                    if let Some(turn) = history["entitiesByKey"].get(key) { turns.push(turn.clone()); }
+                    else { truncated = true; }
+                }
+            }
+        }
+    }
+    for overlay in state["turns"].as_array().into_iter().flatten() {
+        if let Some(i) = turn_key(overlay).and_then(|key| turns.iter().position(|t| turn_key(t) == Some(key))) {
+            // Canonical items remain unless a live item with the same id replaces them.
+            let mut items = turns[i]["items"].as_array().cloned().unwrap_or_default();
+            for item in overlay["items"].as_array().into_iter().flatten() {
+                if let Some(p) = item["id"].as_str().and_then(|id| items.iter().position(|v| v["id"] == id)) {
+                    items[p] = item.clone();
+                } else if !items.contains(item) { items.push(item.clone()); }
+            }
+            let mut merged = turns[i].as_object().cloned().unwrap_or_default();
+            if let Some(fields) = overlay.as_object() { merged.extend(fields.clone()); }
+            merged.insert("items".into(), Value::Array(items));
+            turns[i] = Value::Object(merged);
+        } else { turns.push(overlay.clone()); }
+    }
+    let active_turn_id = turns.iter().rev().find(|t| t["status"] == "inProgress")
+        .and_then(|t| t["turnId"].as_str()).filter(|v| !v.is_empty()).map(str::to_owned);
+    let active = turns.iter().any(|t| t["status"] == "inProgress") || state["threadRuntimeStatus"]["type"] == "active";
+    let mut messages = Vec::new();
+    for turn in &turns {
+        let items = turn["items"].as_array().map(Vec::as_slice).unwrap_or(&[]);
+        if !items.iter().any(|i| i["type"] == "userMessage") {
+            let content = text_input(&turn["params"]["input"]);
+            if !content.is_empty() { messages.push(Message { role: "user", content }); }
+        }
+        for item in items {
+            let (role, content) = match item["type"].as_str() {
+                Some("userMessage") => ("user", text_input(&item["content"])),
+                Some("agentMessage") => ("assistant", item["text"].as_str().unwrap_or("").to_owned()),
+                _ => continue,
+            };
+            if !content.is_empty() { messages.push(Message { role, content }); }
+        }
+    }
+    if messages.len() > 100 { messages.drain(..messages.len() - 100); truncated = true; }
+    let mut remaining = 256 * 1024;
+    for message in messages.iter_mut().rev() {
+        let limit = remaining.min(32 * 1024);
+        if message.content.len() > limit {
+            let mut boundary = limit;
+            while !message.content.is_char_boundary(boundary) { boundary -= 1; }
+            message.content.truncate(boundary);
+            truncated = true;
+        }
+        remaining -= message.content.len();
+    }
+    messages.retain(|m| !m.content.is_empty());
+    Snapshot { thread_id: thread.to_owned(), messages, active, active_turn_id,
+        pending: state["requests"].as_array().is_some_and(|v| !v.is_empty()), truncated }
+}
+
+#[cfg(target_os = "linux")]
+mod ipc {
+    use super::*;
+    use std::io::Write;
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::unix::{fs::{FileTypeExt, MetadataExt}, net::UnixStream};
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::{Duration, Instant};
+
+    const BUDGET: Duration = Duration::from_secs(20);
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    fn unique() -> String { format!("coucou-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)) }
+    fn message_id() -> Result<String, String> {
+        let mut bytes = [0u8; 16];
+        std::fs::File::open("/dev/urandom").and_then(|mut file| file.read_exact(&mut bytes)).map_err(|_| err())?;
+        bytes[6] = (bytes[6] & 0x0f) | 0x40;
+        bytes[8] = (bytes[8] & 0x3f) | 0x80;
+        Ok(bytes.iter().enumerate().map(|(i, b)| format!("{}{b:02x}", if [4,6,8,10].contains(&i) { "-" } else { "" })).collect())
+    }
+    fn err() -> String { UNAVAILABLE.into() }
+    fn secure(meta: &std::fs::Metadata, uid: u32, socket: bool) -> bool {
+        meta.uid() == uid && !meta.file_type().is_symlink() &&
+            if socket { meta.file_type().is_socket() && meta.mode() & 0o777 == 0o600 }
+            else { meta.is_dir() && meta.mode() & 0o077 == 0 }
+    }
+
+    fn connect(path: &std::path::Path, deadline: Instant) -> Result<UnixStream, String> {
+        let uid = unsafe { libc::geteuid() };
+        let parent = path.parent().ok_or_else(err)?;
+        if !secure(&std::fs::symlink_metadata(parent).map_err(|_| err())?, uid, false) ||
+            !secure(&std::fs::symlink_metadata(path).map_err(|_| err())?, uid, true) { return Err(err()); }
+        let bytes = std::os::unix::ffi::OsStrExt::as_bytes(path.as_os_str());
+        let mut addr: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+        if bytes.len() >= addr.sun_path.len() { return Err(err()); }
+        addr.sun_family = libc::AF_UNIX as _;
+        for (out, byte) in addr.sun_path.iter_mut().zip(bytes) { *out = *byte as _; }
+        let fd = unsafe { libc::socket(libc::AF_UNIX, libc::SOCK_STREAM | libc::SOCK_NONBLOCK | libc::SOCK_CLOEXEC, 0) };
+        if fd < 0 { return Err(err()); }
+        let stream = unsafe { UnixStream::from_raw_fd(fd) };
+        let result = unsafe { libc::connect(fd, &addr as *const _ as *const libc::sockaddr, std::mem::size_of_val(&addr) as _) };
+        if result != 0 {
+            let code = std::io::Error::last_os_error().raw_os_error();
+            if code != Some(libc::EINPROGRESS) { return Err(err()); }
+            let mut poll = libc::pollfd { fd, events: libc::POLLOUT, revents: 0 };
+            let millis = deadline.saturating_duration_since(Instant::now()).as_millis().min(i32::MAX as u128) as i32;
+            if unsafe { libc::poll(&mut poll, 1, millis) } <= 0 || stream.take_error().map_err(|_| err())?.is_some() { return Err(err()); }
+        }
+        // Peer credentials also protect against replacing the socket after stat.
+        let mut peer: libc::ucred = unsafe { std::mem::zeroed() };
+        let mut len = std::mem::size_of_val(&peer) as libc::socklen_t;
+        if unsafe { libc::getsockopt(stream.as_raw_fd(), libc::SOL_SOCKET, libc::SO_PEERCRED,
+            &mut peer as *mut _ as *mut _, &mut len) } != 0 || peer.uid != uid { return Err(err()); }
+        stream.set_nonblocking(false).map_err(|_| err())?;
+        Ok(stream)
+    }
+
+    pub(super) struct Client {
+        socket: UnixStream, deadline: Instant, client: String, owner: String, thread: String,
+        state: Option<Value>, revision: u64, serial: usize, frames: usize, bytes: usize, following: bool,
+    }
+    impl Client {
+        pub(super) fn new(thread: &str) -> Result<Self, String> {
+            validate_thread(thread)?;
+            let deadline = Instant::now() + BUDGET;
+            let socket = connect(&codex_home()?.join("ipc/ipc.sock"), deadline)?;
+            let mut c = Self { socket, deadline, client: "initializing-client".into(), owner: String::new(),
+                thread: thread.into(), state: None, revision: 0, serial: 0, frames: 0, bytes: 0, following: false };
+            let init = c.request("initialize", json!({"clientType":"coucou"}), 0, false)?;
+            c.client = init["result"]["clientId"].as_str().filter(|v| !v.is_empty()).ok_or_else(err)?.into();
+            let found = c.request("thread-owner-discovery", json!({"hostId":"local","conversationId":thread}), 1, false)?;
+            c.owner = found["handledByClientId"].as_str().filter(|v| !v.is_empty()).ok_or_else(err)?.into();
+            if found["result"]["supportsUntrustedAppInput"] != true { return Err("Esta versión de Codex no permite integrar el chat.".into()); }
+            c.following = true;
+            c.follow(true)?;
+            let loaded = c.request("thread-follower-load-complete-history", json!({"conversationId":thread}), 1, true)?;
+            let revision = loaded["result"]["revision"].as_u64().ok_or_else(err)?;
+            let serial = c.serial;
+            // Repeated following=true explicitly asks the owner for a fresh full snapshot.
+            c.follow(true)?;
+            while c.serial == serial || c.revision < revision { c.receive()?; }
+            Ok(c)
+        }
+        fn timeout(&self) -> Result<Duration, String> {
+            self.deadline.checked_duration_since(Instant::now()).filter(|v| !v.is_zero()).ok_or_else(err)
+        }
+        fn send(&mut self, value: &Value) -> Result<(), String> {
+            let data = serde_json::to_vec(value).map_err(|_| err())?;
+            if data.is_empty() || data.len() > MAX_FRAME { return Err(err()); }
+            let mut framed = (data.len() as u32).to_le_bytes().to_vec(); framed.extend(data);
+            let mut at = 0;
+            while at < framed.len() {
+                self.socket.set_write_timeout(Some(self.timeout()?)).map_err(|_| err())?;
+                let n = self.socket.write(&framed[at..]).map_err(|_| err())?;
+                if n == 0 { return Err(err()); } at += n;
+            }
+            Ok(())
+        }
+        fn exact(&mut self, bytes: &mut [u8]) -> Result<(), String> {
+            let mut at = 0;
+            while at < bytes.len() {
+                self.socket.set_read_timeout(Some(self.timeout()?)).map_err(|_| err())?;
+                let n = self.socket.read(&mut bytes[at..]).map_err(|_| err())?;
+                if n == 0 { return Err(err()); } at += n;
+            }
+            Ok(())
+        }
+        fn receive(&mut self) -> Result<Value, String> {
+            self.frames += 1; if self.frames > 2048 { return Err(err()); }
+            let mut header = [0; 4]; self.exact(&mut header)?;
+            let size = frame_size(header)?;
+            self.bytes += size; if self.bytes > 64 * 1024 * 1024 { return Err(err()); }
+            let mut body = vec![0; size]; self.exact(&mut body)?;
+            let m: Value = serde_json::from_slice(&body).map_err(|_| err())?;
+            if m["type"] == "client-discovery-request" {
+                self.send(&json!({"type":"client-discovery-response","requestId":m["requestId"],"response":{"canHandle":false}}))?;
+            }
+            if m["type"] == "broadcast" && m["method"] == "thread-stream-state-changed" && m["version"] == 11 &&
+                m["sourceClientId"] == self.owner && m["params"]["conversationId"] == self.thread && m["params"]["hostId"] == "local" {
+                let change = &m["params"]["change"];
+                if change["type"] == "snapshot" && change["conversationState"].is_object() {
+                    self.revision = change["revision"].as_u64().ok_or_else(err)?;
+                    self.state = Some(change["conversationState"].clone()); self.serial += 1;
+                }
+            }
+            Ok(m)
+        }
+        fn request(&mut self, method: &str, params: Value, version: u32, target: bool) -> Result<Value, String> {
+            let id = unique();
+            let mut message = json!({"type":"request","requestId":id,"sourceClientId":self.client,
+                "method":method,"version":version,"params":params,"timeoutMs":15000});
+            if target { message["targetClientId"] = self.owner.clone().into(); }
+            self.send(&message)?;
+            loop {
+                let response = self.receive()?;
+                if response["type"] == "response" && response["requestId"] == id {
+                    if response["resultType"] != "success" { return Err("Codex rechazó la operación del chat.".into()); }
+                    return Ok(response);
+                }
+            }
+        }
+        fn follow(&mut self, following: bool) -> Result<(), String> {
+            self.send(&json!({"type":"broadcast","sourceClientId":self.client,"version":1,
+                "method":"thread-stream-following-changed","targetClientIds":[self.owner],
+                "params":{"hostId":"local","conversationId":self.thread,"following":following}}))
+        }
+        pub(super) fn snapshot(&self) -> Result<Snapshot, String> {
+            Ok(normalize(&self.thread, self.state.as_ref().ok_or_else(err)?))
+        }
+        pub(super) fn start(&mut self, query: &str) -> Result<(), String> {
+            let snapshot = self.snapshot()?;
+            if snapshot.active || snapshot.pending { return Err("Espera a que termine Codex o resuelve su petición en el chat completo.".into()); }
+            let result = self.request("thread-follower-start-turn", json!({"conversationId":self.thread,
+                "turnStart":{"request":{"threadId":self.thread,"input":[{"type":"text","text":query,"text_elements":[]}],
+                "clientUserMessageId":message_id()?}}}), 2, true);
+            // A lost response can follow an accepted send. Never retry automatically.
+            result.map(|_| ()).map_err(|_| "No se confirmó el envío. Comprueba el chat antes de volver a enviar.".into())
+        }
+        pub(super) fn interrupt(&mut self, expected: &str) -> Result<(), String> {
+            if self.snapshot()?.active_turn_id.as_deref() != Some(expected) {
+                return Err("El turno activo ha cambiado. Actualiza el chat antes de detenerlo.".into());
+            }
+            let result = self.request("thread-follower-interrupt-turn", json!({"conversationId":self.thread,
+                "mode":"user-stop","expectedTurnId":expected}), 4, true)?;
+            if result["result"]["ok"] != true || result["result"]["interruptedTurnId"] != expected {
+                return Err("Codex no confirmó la parada de este turno.".into());
+            }
+            Ok(())
+        }
+    }
+    impl Drop for Client {
+        fn drop(&mut self) {
+            if self.following {
+                self.deadline = Instant::now() + Duration::from_millis(100);
+                let _ = self.follow(false);
+            }
+        }
+    }
+    fn frame_size(bytes: [u8; 4]) -> Result<usize, String> {
+        let size = u32::from_le_bytes(bytes) as usize;
+        if size == 0 || size > MAX_FRAME { Err(err()) } else { Ok(size) }
+    }
+    #[cfg(test)]

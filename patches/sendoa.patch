+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readDashboard, sectionTitle, safeGitHubUrl } from '../src/core/github.ts';
+import { setLanguage } from '../src/i18n/i18n.ts';
+import { calls, sent } from './tauri.mjs';
+
+test('personal dashboard is available without a GraphQL PR pulse', () => {
+  const dashboard = { login:'me', repositories:[], commits:[], pipelines:[], commitsUnavailable:0, pipelinesUnavailable:0, truncated:false, fetchedAt:123 };
+  assert.deepEqual(readDashboard({dashboard}), dashboard);
+  assert.equal(readDashboard({}), null);
+  assert.equal(readDashboard({dashboard:{login:'me', repositories:[]}}), null);
+});
+
+test('repository, commit and running pipeline sections open their actual GitHub targets', async () => {
+  const { installFakeDom } = await import('./fakedom.mjs');
+  installFakeDom();
+  const { githubPulseCard, githubDetail, listRows, openRow } = await import('../src/views/github.ts');
+  const dashboard = {
+    login:'me', repositories:[{repo:'me/private',url:'https://github.com/me/private',private:true,branch:'main',description:'Private project',pushedAt:''}],
+    commits:[{repo:'me/private',url:'https://github.com/me/private/commit/abc',sha:'abc',message:'Fix <script> as plain text',author:'Me',date:'2026-10-09T00:00:00Z'}],
+    pipelines:[{repo:'me/private',url:'https://github.com/me/private/actions/runs/1',name:'Build',branch:'main',status:'in_progress',startedAt:''},
+      {repo:'me/private',url:'https://github.com/me/private/actions/runs/2',name:'Old',branch:'main',status:'completed',startedAt:''}],
+    commitsUnavailable:0,pipelinesUnavailable:0,truncated:false,fetchedAt:1,
+  };
+  const card = githubPulseCard(null,null,null,()=>{},undefined,dashboard);
+  const buttons = card.querySelector('.gh-rows').children;
+  const targets = [dashboard.repositories[0].url, dashboard.commits[0].url, dashboard.pipelines[0].url];
+  for (let i=0; i<3; i++) {
+    buttons[i].fire('click');
+    const detail = githubDetail(null,null,null,()=>{},undefined,dashboard);
+    const rows = listRows(detail);
+    assert.equal(rows.length,1);
+    calls.length=0;
+    openRow(rows[0]);
+    assert.deepEqual(sent('open_url'),[{url:targets[i]}]);

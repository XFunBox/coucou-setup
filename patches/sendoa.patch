new file mode 100644
index 0000000..0423783
--- /dev/null
+++ b/windows/src/core/codex-flow.ts
@@ -0,0 +1,26 @@
+import type { AgentTask } from './state';
+
+export interface FlowAgent {
+  id: string; parentId: string | null; name: string; role: string | null;
+  model: string | null; effort: string | null;
+  status: 'working' | 'completed' | 'interrupted' | 'unknown';
+  tool: string | null; lastSeen: string | null;
+}
+export interface FlowSnapshot {
+  rootId: string | null; agents: FlowAgent[]; truncated: boolean; warnings: string[];
+}
+/** Local session metadata only. Never enters the phone/chat integration. */
+export const CodexFlow = { snapshot: null as FlowSnapshot | null, tasks: [] as AgentTask[], error: false };
+
+export function applyFlow(snapshot: FlowSnapshot | null) {
+  CodexFlow.snapshot = snapshot;
+  CodexFlow.error = snapshot === null;
+  CodexFlow.tasks = (snapshot?.agents ?? []).map(agent => ({
+    id: agent.id === snapshot?.rootId ? 'agent_codex' : `codex_child_${agent.id}`,
+    name: agent.id === snapshot?.rootId ? 'Codex · principal' : agent.name.split('/').filter(Boolean).at(-1) || agent.name,
+    color: agent.id === snapshot?.rootId ? '#b4ff39' : '#b18aff',
+    state: agent.status === 'completed' ? 'finished' : agent.status === 'working' ? 'working' : agent.status === 'interrupted' ? 'error' : 'idle',
+    source: 'agent', isIntegration: false, steps: [agent.tool || ''], stepIndex: 0,
+    flow: agent,
+  }));
+}

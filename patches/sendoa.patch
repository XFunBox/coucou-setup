@@ -0,0 +1,89 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { installFakeDom } from './fakedom.mjs';
+import { calls, internals, sent } from './tauri.mjs';
+installFakeDom();
+const { buildCodexChat } = await import('../src/views/codex-chat.ts');
+const original = internals.invoke;
+let snapshotCalls = 0;
+internals.invoke = async (cmd, args) => {
+  await original(cmd, args);
+  if (cmd === 'codex_chat_threads') return [{ id: 'test', title: 'Prueba' }];
+  if (cmd === 'codex_chat_snapshot') { snapshotCalls++; return { threadId: args.threadId, messages: [{role:'assistant', content:'LISTO'}], active: false, pending: false, truncated: false }; }
+  if (cmd === 'codex_chat_send') throw new Error('Desconectado: entrega desconocida');
+  return null;
+};
+const flush = () => new Promise(resolve => setTimeout(resolve, 0));
+test('Codex requires explicit selection, keeps a failed draft, and does not retry send', async () => {
+  const view = buildCodexChat(() => {});
+  calls.length = 0;
+  view.setVisible(true);
+  await flush(); await flush();
+  assert.equal(snapshotCalls, 0);
+  view.el.querySelector('.codex-thread').fire('click');
+  await flush(); await flush();
+  assert.match(view.el.textContent, /LISTO/);
+  const input = view.el.querySelector('.codex-input');
+  input.value = 'mensaje';
+  view.el.querySelector('.codex-send').fire('click');
+  await flush(); await flush();
+  assert.equal(input.value, 'mensaje');
+  assert.equal(sent('codex_chat_send').length, 1);
+  assert.match(view.el.textContent, /entrega desconocida/);
+  await new Promise(resolve => setTimeout(resolve, 2700));
+  assert.equal(input.value, 'mensaje');
+  assert.equal(sent('codex_chat_send').length, 1);
+  assert.match(view.el.textContent, /entrega desconocida/);
+  assert.equal(input.disabled, false);
+  view.setVisible(false);
+});
+
+test('stop carries the displayed turn id; pending decisions block send', async () => {
+  let pending = false;
+  internals.invoke = async (cmd, args) => {
+    await original(cmd, args);
+    if (cmd === 'codex_chat_threads') return [{id:'test',title:'Prueba'}];
+    if (cmd === 'codex_chat_snapshot') return {threadId:'test',messages:[],active:!pending,activeTurnId:pending?null:'turn-1',pending,truncated:false};
+    if (cmd === 'codex_chat_interrupt') pending = true;
+    return null;
+  };
+  const view = buildCodexChat(() => {});
+  view.setVisible(true);
+  await flush(); await flush();
+  view.el.querySelector('.codex-thread').fire('click');
+  await flush(); await flush();
+  assert.equal(view.el.querySelector('.codex-send').disabled, true);
+  view.el.querySelector('.codex-stop').fire('click');
+  await flush(); await flush();
+  assert.equal(sent('codex_chat_interrupt').at(-1).expectedTurnId, 'turn-1');
+  assert.match(view.el.textContent,/requiere tu decisión/);
+  assert.equal(view.el.querySelector('.codex-send').disabled,true);
+  view.setVisible(false);
+});
+
+
+test('a rejected stop resumes status reads without repeating the action', async () => {
+  let stopped = false;
+  internals.invoke = async (cmd, args) => {
+    await original(cmd, args);
+    if (cmd === 'codex_chat_threads') return [{id:'test',title:'Prueba'}];
+    if (cmd === 'codex_chat_snapshot') return {threadId:'test',messages:[],active:!stopped,activeTurnId:stopped?null:'old-turn',pending:false,truncated:false};
+    if (cmd === 'codex_chat_interrupt') { stopped = true; throw new Error('El turno activo ha cambiado'); }
+    return null;
+  };
+  calls.length = 0;
+  const view = buildCodexChat(() => {});
+  try {
+    view.setVisible(true);
+    await flush(); await flush();
+    view.el.querySelector('.codex-thread').fire('click');
+    await flush(); await flush();
+    view.el.querySelector('.codex-stop').fire('click');
+    await flush(); await flush();
+    assert.match(view.el.textContent,/turno activo ha cambiado/);
+    await new Promise(resolve => setTimeout(resolve, 2700));
+    assert.equal(view.el.querySelector('.codex-input').disabled,false);
+    assert.match(view.el.textContent,/Conectado al chat seleccionado/);
+    assert.equal(sent('codex_chat_interrupt').length,1);
+  } finally { view.setVisible(false); }
+});

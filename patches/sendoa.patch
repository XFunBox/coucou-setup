+  }
+  dashboard.pipelines=[];
+  dashboard.pipelinesUnavailable=1;
+  assert.ok(githubDetail(null,null,null,()=>{},undefined,dashboard).textContent.includes('Check token permissions'));
+});
+
+test('new sections have Spanish labels and links retain GitHub-only validation', () => {
+  setLanguage('es');
+  assert.equal(sectionTitle('commits'), 'Últimos commits');
+  assert.equal(sectionTitle('pipelines'), 'Pipelines activos');
+  assert.equal(safeGitHubUrl('https://evil.example/commit/abc'), null);
+  assert.equal(safeGitHubUrl('https://github.com/me/repo/commit/abc'), 'https://github.com/me/repo/commit/abc');
+  setLanguage('en');
+});

--- /dev/null
+++ b/windows/tests/quota-rings.test.mjs
@@ -0,0 +1,96 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import * as plan from '../src/core/plan.ts';
+const now = Date.UTC(2026, 10, 1, 20);
+const window = (usedPercent, duration = 300, reset = now / 1000 + 3600) =>
+  ({ usedPercent, windowDurationMins: duration, resetsAt: reset });
+
+test('quota groups preserve durations and never combine model limits', () => {
+  const u = plan.parseCodexPlan({ rateLimits: { primary: window(99) }, rateLimitsByLimitId: {
+    codex: { limitName: 'Codex', primary: window(25, 120), secondary: window(80, 1440) },
+    review: { limitName: 'Review', primary: window(5, 10080) },
+  } }, now);
+  assert.equal(u.quotaGroups.length, 2);
+  assert.equal(u.quotaGroups[0].label, 'Codex');
+  assert.deepEqual(u.quotaGroups[0].windows.map(w => w.durationMins), [120, 1440]);
+  assert.equal(plan.quotaAvailable(u.quotaGroups[0].windows[0], now), 75);
+  assert.equal(u.quotaGroups[1].windows[0].usedPct, 5);
+});
+
+test('empty or invalid group maps retain valid legacy limits', () => {
+  for (const rateLimitsByLimitId of [{}, { review: { primary: window(null) } }]) {
+    const u = plan.parseCodexPlan({ rateLimits: { planType: 'plus', primary: window(20) }, rateLimitsByLimitId }, now);
+    assert.equal(u.quotaGroups[0].windows[0].usedPct, 20);
+    assert.equal(u.planType, 'plus');
+  }
+});
+
+test('missing, non-finite and reset windows never imply full availability', () => {
+  assert.equal(plan.quotaAvailable(undefined, now), null);
+  assert.equal(plan.quotaAvailable({ usedPct: 80, resetsAt: now }, now), null);
+  assert.equal(plan.quotaAvailable({ usedPct: NaN, resetsAt: now + 1000 }, now), null);
+  assert.equal(plan.quotaAvailable({ usedPct: 0, resetsAt: now + 1000 }, now), 100);
+  assert.equal(plan.quotaAvailable({ usedPct: 100, resetsAt: now + 1000 }, now), 0);
+  const u = plan.parseCodexPlan({ rateLimits: { primary: window(null), secondary: window(40, 300, 0) } }, now);
+  assert.equal(u, null);
+});
+
+test('legacy limits remain supported and unknown durations remain unknown', () => {
+  const u = plan.parseCodexPlan({ rateLimits: { primary: window(150, null), secondary: window(-5, 300) } }, now);
+  assert.deepEqual(u.quotaGroups[0].windows.map(w => w.usedPct), [100, 0]);
+  assert.equal(u.quotaGroups[0].windows[0].durationMins, undefined);
+});
+
+import { installFakeDom } from './fakedom.mjs';
+import { State } from '../src/core/state.ts';
+import { buildQuotaRings, PlanCard } from '../src/views/usage.ts';
+import { Island } from '../src/island/island.ts';
+
+test('rings label availability, stale readings and every provider group in the detail', () => {
+  installFakeDom();
+  State.codexPlanUsage = plan.parseCodexPlan({ rateLimitsByLimitId: {
+    codex: { primary: window(25, 120), secondary: window(100, 1440) },
+    review: { primary: window(5, 10080) },
+  } }, now);
+  const rings = buildQuotaRings();
+  rings.sync(now);
+  assert.match(rings.el.getAttribute('aria-label'), /2 h: 75% available/);
+  assert.match(rings.el.getAttribute('aria-label'), /1 d: 0% available/);
+  assert.deepEqual(rings.el.children.map(e => e.textContent), ['75', '0']);
+  rings.sync(now + 60_000);
+  assert.equal(rings.el.classList.contains('stale'), true);
+  rings.sync(now + 3600_000);
+  assert.deepEqual(rings.el.children.map(e => e.textContent), ['?', '?']);
+  State.planDetailIsCodex = true;
+  const card = new PlanCard();
+  card.sync(now);
+  assert.match(card.el.textContent, /review/);
+  assert.match(card.el.textContent, /95% available/);
+  State.codexPlanUsage = null;
+  rings.sync(now);
+  assert.match(rings.el.getAttribute('aria-label'), /No data/);
+  State.planDetailIsCodex = false;
+});
+
+test('compact rings yield to pending permissions, music, pause and hidden mode', () => {
+  installFakeDom();
+  const saved = { mode: State.mode, paused: State.paused, stateOverride: State.stateOverride,
+    pendingApproval: State.pendingApproval, codexPlanUsage: State.codexPlanUsage };
+  const show = State.settings.showCodexPlanInNotch;
+  const host = { currentNotice: Island.prototype.currentNotice, quotaButton: document.createElement('button'), islandEl: document.createElement('div'),
+    quotaRings: buildQuotaRings(), compactMusic: { visible: false }, quotaShown: true };
+  const draw = () => Island.prototype.updateQuota.call(host);
+  try {
+    State.mode = 'compact'; State.paused = false; State.settings.showCodexPlanInNotch = true;
+    State.stateOverride = 'working'; State.pendingApproval = null;
+    State.codexPlanUsage = plan.parseCodexPlan({ rateLimits: { primary: { ...window(25), resetsAt: Date.now() / 1000 + 3600 } } });
+    draw(); assert.equal(host.quotaButton.style.display, 'flex');
+    assert.equal(host.islandEl.classList.contains('has-quota'), true);
+    State.pendingApproval = {}; draw(); assert.equal(host.quotaButton.style.display, 'none');
+    State.pendingApproval = null; host.compactMusic.visible = true; draw(); assert.equal(host.quotaButton.style.display, 'none');
+    host.compactMusic.visible = false; State.paused = true; draw(); assert.equal(host.quotaButton.style.display, 'none');
+    State.paused = false; State.mode = 'hidden'; draw(); assert.equal(host.quotaButton.style.display, 'none');
+  } finally {
+    State.settings.showCodexPlanInNotch = show; Object.assign(State, saved);
+  }
+});

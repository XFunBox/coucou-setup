+        #[test] fn framing_is_little_endian_and_bounded() {
+            assert_eq!(frame_size([0, 1, 0, 0]).unwrap(), 256);
+            assert!(frame_size([0; 4]).is_err()); assert!(frame_size(u32::MAX.to_le_bytes()).is_err());
+        }
+        #[test] fn fragmented_frames_are_read_completely_and_eof_fails() {
+            let (socket, mut peer) = UnixStream::pair().unwrap();
+            let worker = std::thread::spawn(move || {
+                for byte in b"\x02\x00\x00\x00{}" { peer.write_all(&[*byte]).unwrap(); }
+            });
+            let mut client = Client { socket, deadline: Instant::now() + Duration::from_secs(1),
+                client: "test".into(), owner: "owner".into(), thread: "test".into(), state: None,
+                revision: 0, serial: 0, frames: 0, bytes: 0, following: false };
+            assert_eq!(client.receive().unwrap(), json!({}));
+            worker.join().unwrap(); assert!(client.receive().is_err());

+++ b/windows/tests/compact-music.test.mjs
@@ -0,0 +1,97 @@
+import { afterEach, beforeEach, mock, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { installFakeDom } from './fakedom.mjs';
+import { buildCompactMusic, buildCompactClock, compactAlert } from '../src/island/compact.ts';
+import { IDLE_SPOTIFY, Spotify } from '../src/core/spotify.ts';
+
+installFakeDom();
+beforeEach(() => mock.timers.enable({ apis: ['setTimeout'] }));
+afterEach(() => { mock.timers.reset(); Spotify.artwork = null; });
+const track = { id: 'mpris:1', title: '<b>Get Lucky</b>', artist: 'Daft Punk', album: '', duration: 100, artUrl: 'file:///cover' };
+const report = (playing = true, loaded = track) => ({ ...IDLE_SPOTIFY, track: loaded, playing });
+
+test('compact music shows text safely, cached artwork and opens its card', () => {
+  let opened = 0;
+  const music = buildCompactMusic(() => opened++, () => {});
+  Spotify.artwork = { artUrl: track.artUrl, dataUrl: 'data:image/png;base64,AA' };
+  music.sync(report(), true, false);
+  assert.ok(music.visible);
+  assert.match(music.el.textContent, /<b>Get Lucky<\/b>Daft Punk/);
+  assert.equal(music.el.find('IMG')[0].getAttribute('src'), Spotify.artwork.dataUrl);
+  music.el.fire('click');
+  assert.equal(opened, 1);
+  Spotify.artwork.artUrl = 'file:///previous-cover';
+  music.sync(report(), true, false);
+  assert.equal(music.el.find('IMG')[0].getAttribute('src'), null, 'never reuse another track cover');
+});
+
+test('pause or stop retains music for one second and resume cancels the return', () => {
+  let changes = 0;
+  const music = buildCompactMusic(() => {}, () => changes++);
+  music.sync(report(), true, false);
+  music.sync(report(false, null), false, false);
+  mock.timers.tick(999);
+  assert.ok(music.visible);
+  assert.match(music.el.textContent, /Get Lucky/);
+  music.sync(report(), true, false);
+  mock.timers.tick(1000);
+  assert.ok(music.visible);
+  assert.equal(changes, 0);
+  music.sync(report(false), false, false);
+  mock.timers.tick(1000);
+  assert.equal(music.visible, false);
+  assert.equal(changes, 1);
+});
+
+test('permissions and alerts suppress compact music without consuming playback', () => {
+  const music = buildCompactMusic(() => {}, () => {});
+  for (const state of ['approval', 'question', 'error', 'ratelimit', 'finished', 'dizzy']) {
+    assert.ok(compactAlert(state, false), state);
+    music.sync(report(), true, compactAlert(state, false));
+    assert.equal(music.visible, false);
+  }
+  assert.ok(compactAlert('idle', true));
+  assert.equal(compactAlert('working', false), false);
+  music.sync(report(), true, false);
+  assert.ok(music.visible);
+});
+
+test('the compact clock renders hour first and date below it', () => {
+  const clock = buildCompactClock();
+  const now = new Date(2026, 9, 29, 18, 42);
+  clock.sync(now);
+  assert.equal(clock.el.children.length, 2);
+  assert.equal(clock.el.children[0].textContent, now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
+  assert.equal(clock.el.children[1].textContent, now.toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' }));
+});
+
+test('island geometry and hide protection return to normal when the grace expires', async () => {
+  const { Island } = await import('../src/island/island.ts');
+  const { IslandStateMachine } = await import('../src/island/fsm.ts');
+  const { State, DEFAULT_SETTINGS } = await import('../src/core/state.ts');
+  const previous = { settings: State.settings, os: State.os, mode: State.mode, tasks: State.tasks, focusId: State.focusId, pendingApproval: State.pendingApproval, spotify: Spotify.state };
+  try {
+    State.settings = { ...DEFAULT_SETTINGS, activeIntegrations: ['integration_spotify'] };
+    State.os = 'linux'; State.mode = 'compact'; State.tasks = []; State.focusId = null; State.pendingApproval = null;
+    let host;
+    const draw = () => Island.prototype.syncCompactMusic.call(host);
+    const music = buildCompactMusic(() => {}, draw);
+    const sizes = [];
+    host = { currentNotice: Island.prototype.currentNotice, compactMusic: music, fsm: new IslandStateMachine(), wasInIsland: false,
+      animateGeometry() { sizes.push(Island.prototype.targetSize.call(host).w); } };
+    host.fsm.reveal();
+    Spotify.state = report(); draw();
+    assert.equal(host.fsm.musicVisible, true);
+    assert.equal(sizes.at(-1), 400);
+    Spotify.state = report(false, null); draw();
+    mock.timers.tick(999);
+    assert.equal(host.fsm.musicVisible, true);
+    mock.timers.tick(1);
+    assert.equal(host.fsm.musicVisible, false);
+    assert.equal(sizes.at(-1), 288);
+    mock.timers.tick(60_000);
+    assert.equal(host.fsm.state, 'hidden');
+  } finally {
+    State.settings = previous.settings; State.os = previous.os; State.mode = previous.mode; State.tasks = previous.tasks; State.focusId = previous.focusId; State.pendingApproval = previous.pendingApproval; Spotify.state = previous.spotify;
+  }
+});
diff --git a/windows/tests/compact-notice.test.mjs b/windows/tests/compact-notice.test.mjs

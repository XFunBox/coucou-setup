+  emit("spotify", playing({ playerName: "Spotifast / EVA-01" }));
+  pill.sync();
+  assert.equal(pill.el.querySelector("lbl").textContent, "Get Lucky");
+  emit("spotify", playing({ playerName: "Spotifast / EVA-01", track: track({ id: "spotify:ad:1", title: "" }) }));
+  pill.sync();
+  assert.equal(pill.el.querySelector("lbl").textContent, "Advertisement");
+});
+
+test("transport buttons reject unknown and revoked player capabilities", () => {
+  const card = buildSpotifyCard();
+  const pill = buildSpotifyPill(spotifyTask(), () => {});
+  Spotify.state = playing({ capabilities: undefined });
+  card.sync(); pill.sync();
+  const [, prev, play, next] = card.el.querySelector("np-buttons").children;
+  const [pillPlay, pillNext] = pill.el.querySelector("np-pill-controls").children;
+  const before = sent("spotify_control").length;
+  for (const button of [prev, play, next, pillPlay, pillNext]) {
+    assert.equal(button.getAttribute("disabled"), "");
+    button.fire("click");
+  }
+  assert.equal(sent("spotify_control").length, before);
+  assert.equal(Spotify.state.playing, true, "disabled click must not update playback optimistically");
+  Spotify.state = playing({ capabilities: { canControl: true, canPlay: true, canPause: false, canGoNext: true } });
+  card.sync(); pill.sync();
+  assert.equal(play.getAttribute("disabled"), "", "pause needs CanPause while playing");
+  assert.equal(prev.getAttribute("disabled"), "", "unknown previous stays disabled");
+  assert.equal(next.getAttribute("disabled"), null);
+  Spotify.state = { ...Spotify.state, playing: false }; card.sync();
+  assert.equal(play.getAttribute("disabled"), null, "play needs CanPlay while paused");
+  Spotify.state = { ...Spotify.state, capabilities: { ...Spotify.state.capabilities, canControl: false } };
+  next.fire("click");
+  assert.equal(sent("spotify_control").length, before, "click checks current capabilities before sync");
+  card.sync();
+  assert.equal(next.getAttribute("disabled"), "", "CanControl overrides specific capabilities");
+});
+
+test("a report from a different player cannot inherit transport capabilities or position", () => {
+  const card = buildSpotifyCard();
+  emit("spotify", playing({ playerName: "Spotifast" })); card.sync();
+  assert.equal(card.el.querySelector("np-buttons").children[3].getAttribute("disabled"), null);
+  emit("spotify", { ...IDLE_SPOTIFY, running: true, playerName: "Browser", track: track() }); card.sync();
+  assert.equal(card.el.querySelector("np-buttons").children[3].getAttribute("disabled"), "");
+  assert.equal(card.el.querySelector("np-progress").style.display, "none");
+});
+
+test("progress needs duration and position; seeking also needs CanSeek", () => {
+  const card = buildSpotifyCard();
+  for (const over of [{ positionKnown: false }, { position: Number.NaN }, { track: track({ duration: 0 }) }, { track: track({ duration: Number.NaN }) }]) {
+    Spotify.state = playing(over); card.sync();
+    assert.equal(card.el.querySelector("np-progress").style.display, "none");
+  }
+  Spotify.state = playing({ playing: false, capabilities: { canControl: true, canSeek: false } }); card.sync();
+  const row = card.el.querySelector("np-progress");
+  const bar = row.querySelector("np-bar");
+  assert.equal(row.style.display, "");
+  assert.equal(bar.getAttribute("aria-disabled"), "true");
+  const pointer = (type) => {
+    for (const fn of bar.listeners.get(type) ?? []) fn({ button: 0, pointerId: 1, clientX: 1, stopPropagation() {} });
+  };
+  const before = sent("spotify_control").length;
+  pointer("pointerdown"); pointer("pointerup");
+  assert.equal(sent("spotify_control").length, before);
+  Spotify.state = playing({ playing: false }); card.sync();
+  assert.equal(bar.getAttribute("aria-disabled"), "false");
+  pointer("pointerdown"); pointer("pointerup");
+  assert.equal(sent("spotify_control").length, before + 1);
+  assert.equal(sent("spotify_control").at(-1).action, "seek");
+  Spotify.state = playing({ track: track({ id: "spotify:ad:1" }) }); card.sync();
+  assert.equal(bar.getAttribute("aria-disabled"), "true", "ad seeking stays blocked");
+});
diff --git a/windows/tests/task-history.test.mjs b/windows/tests/task-history.test.mjs
new file mode 100644
index 0000000..636b755
--- /dev/null
+++ b/windows/tests/task-history.test.mjs
@@ -0,0 +1,125 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { installFakeDom } from "./fakedom.mjs";
+import { TaskHistory, TASK_HISTORY_LIMIT } from "../src/core/task-history.ts";
+import { buildTaskHistory } from "../src/views/task-history.ts";
+import { setLanguage, t } from "../src/i18n/i18n.ts";
+
+const event = (over = {}) => ({ source: "hook", kind: "tool_started", ...over });
+
+test("two chats keep separate events even when their event IDs match", () => {
+  const history = new TaskHistory();
+  history.record("chat-a", event({ eventId: "one" }));
+  history.record("chat-b", event({ eventId: "one", kind: "turn_failed" }));
+  assert.equal(history.get("chat-a")[0].kind, "tool_started");
+  assert.equal(history.get("chat-b")[0].kind, "turn_failed");
+  assert.deepEqual(history.get("unknown"), []);
+});
+
+test("replayed IDs are deduplicated per source; unidentified events are not guessed equal", () => {
+  const history = new TaskHistory();
+  assert.equal(history.record("chat", event({ eventId: "one" })), true);
+  assert.equal(history.record("chat", event({ eventId: "one" })), false);
+  assert.equal(history.record("chat", event({ source: "codex", eventId: "one" })), true);
+  history.record("chat", event());
+  history.record("chat", event());
+  assert.equal(history.get("chat").length, 4);
+});
+
+test("dated events are chronological, ties and undated events keep their arrival order", () => {
+  const history = new TaskHistory();
+  for (const [eventId, timestamp] of [["late", 300], ["unknown-a", undefined], ["early", 100], ["same", 100], ["unknown-b", undefined]]) {
+    history.record("chat", event({ eventId, timestamp }));
+  }
+  assert.deepEqual(history.get("chat").map(item => item.eventId), ["early", "same", "late", "unknown-a", "unknown-b"]);
+  assert.equal("timestamp" in history.get("chat")[3], false, "no clock is invented");
+});
+
+test("invalid timestamps remain undated instead of becoming plausible times", () => {
+  const history = new TaskHistory();
+  for (const timestamp of [NaN, Infinity, -1, 8.64e15 + 1]) history.record("chat", event({ timestamp }));
+  assert.equal(history.get("chat").length, 4);
+  assert.ok(history.get("chat").every(item => !("timestamp" in item)));
+  history.record("chat", event({ timestamp: 0 }));
+  assert.equal(history.get("chat")[0].timestamp, 0, "the epoch is a valid explicit date");
+});
+
+test("only the latest 20 dated events survive, including out-of-order replays", () => {
+  const history = new TaskHistory();
+  for (let i = 30; i >= 0; i--) history.record("chat", event({ eventId: String(i), timestamp: i }));
+  assert.equal(TASK_HISTORY_LIMIT, 20);
+  assert.deepEqual(history.get("chat").map(item => item.timestamp), Array.from({ length: 20 }, (_, i) => i + 11));
+  assert.equal(history.record("chat", event({ eventId: "0", timestamp: 0 })), false);
+  assert.equal(history.get("chat").length, 20);
+});
+
+test("undated events are also bounded, and clearing another task leaves them intact", () => {
+  const history = new TaskHistory();
+  for (let i = 0; i < 30; i++) history.record("chat", event({ eventId: String(i) }));
+  history.record("other", event());
+  history.clear("other");
+  assert.deepEqual(history.get("chat").map(item => item.eventId), Array.from({ length: 20 }, (_, i) => String(i + 10)));
+  assert.deepEqual(history.get("other"), []);
+});
+
+test("only safe metadata is retained and callers cannot mutate stored entries", () => {
+  const history = new TaskHistory();
+  const input = event({ eventId: "one", timestamp: 12, tool_input: { command: "secret" }, message: "private", tokens: 200 });
+  history.record("chat", input);
+  input.kind = "turn_failed";
+  const entries = history.get("chat");
+  assert.deepEqual(entries, [{ source: "hook", kind: "tool_started", eventId: "one", timestamp: 12 }]);
+  assert.throws(() => { entries[0].kind = "turn_failed"; }, TypeError);
+  entries.pop();
+  assert.equal(history.get("chat").length, 1);
+});
+
+test("task and session cleanup remove both the history and its dedup state", () => {
+  const history = new TaskHistory();
+  history.record("one", event({ eventId: "reusable" }));
+  history.record("two", event({ kind: "turn_cancelled" }));
+  history.clear("one");
+  assert.equal(history.record("one", event({ eventId: "reusable" })), true);
+  assert.equal(history.get("two").length, 1);
+  history.clearAll();
+  assert.deepEqual(history.get("one"), []);
+  assert.deepEqual(history.get("two"), []);
+  assert.equal(history.record("one", event({ eventId: "reusable" })), true);
+});
+
+test("unknown events, origins and missing task identity do not create history", () => {
+  const history = new TaskHistory();
+  assert.equal(history.record("", event()), false);
+  assert.equal(history.record(" ", event()), false);
+  assert.equal(history.record("chat", event({ kind: "working" })), false);
+  assert.equal(history.record("chat", event({ source: "snapshot" })), false);
+  assert.deepEqual(history.get("chat"), []);
+});
+
+test("the reusable view shows explicit observations and never turns completion into success", () => {
+  installFakeDom();
+  setLanguage("en");
+  const view = buildTaskHistory();
+  view.sync(["tool_started", "tool_finished", "permission_requested", "turn_finished", "turn_failed", "turn_cancelled"].map(kind => event({ kind })));
+  assert.deepEqual(view.el.find("LI").map(row => row.textContent), ["Tool started", "Tool finished", "Permission requested", "Turn finished", "Turn failed", "Turn cancelled"].map(t));
+  assert.equal(view.el.find("SVG").length, 6);
+  assert.equal(view.el.find("TIME").length, 0);
+  assert.doesNotMatch(view.el.textContent, /success|tests passed|investigation|checking/i);
+});
+
+test("sync replaces the selected task, shows only explicit dates, and clears stale rows", () => {
+  installFakeDom();
+  const history = new TaskHistory();
+  history.record("one", event({ timestamp: 1_000 }));
+  history.record("two", event({ kind: "turn_failed" }));
+  const view = buildTaskHistory();
+  view.sync(history.get("one"));
+  assert.equal(view.el.find("TIME")[0].getAttribute("datetime"), "1970-01-01T00:00:01.000Z");
+  view.sync(history.get("two"));
+  assert.equal(view.el.find("TIME").length, 0);
+  assert.equal(view.el.find("LI").length, 1);
+  assert.equal(view.el.find("LI")[0].textContent, t("Turn failed"));
+  view.sync([]);
+  assert.equal(view.el.find("LI").length, 0);
+  assert.ok(view.el.textContent.includes(t("Waiting for activity")));
+});

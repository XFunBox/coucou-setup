diff --git a/windows/src/island/codex-flow.ts b/windows/src/island/codex-flow.ts
new file mode 100644
index 0000000..8232d13
--- /dev/null
+++ b/windows/src/island/codex-flow.ts
@@ -0,0 +1,25 @@
+import { Bridge, IS_TAURI } from '../core/bridge';
+import { State } from '../core/state';
+import { applyFlow } from '../core/codex-flow';
+
+/** One read at a time. Recheck session identity after awaiting the backend. */
+export function registerCodexFlow() {
+  if (!IS_TAURI) return;
+  let busy = false;
+  const session = () => {
+    const task = State.tasks.find(task => task.id === 'agent_codex');
+    const id = task?.sessionId;
+    return id && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id) && task?.state !== 'idle' ? id : null;
+  };
+  async function poll() {
+    if (busy || State.paused) return;
+    busy = true;
+    const root = session();
+    try {
+      const snapshot = await Bridge.codexAgentSnapshot(root);
+      if (session() === root) { applyFlow(snapshot); State.notify(); }
+    } finally { busy = false; }
+  }
+  void poll();
+  window.setInterval(() => void poll(), 2500);
+}
diff --git a/windows/src/island/compact.ts b/windows/src/island/compact.ts
new file mode 100644
index 0000000..fece898
--- /dev/null
+++ b/windows/src/island/compact.ts
@@ -0,0 +1,75 @@
+// Compact island content. Media reports and artwork still come from the shared MPRIS cache.
+import type { BotStateName } from "../core/layout";
+import { currentArtwork, isAd, type SpotifyState, type SpotifyTrack } from "../core/spotify";
+import { t } from "../i18n/i18n";
+import { h } from "../views/dom";
+
+export function compactAlert(state: BotStateName, pendingApproval: boolean): boolean {
+  return pendingApproval || ["approval", "question", "error", "ratelimit", "finished", "dizzy"].includes(state);
+}
+
+export function buildCompactClock() {
+  const time = h("span", { class: "compact-time" });
+  const date = h("span", { class: "compact-date" });
+  const el = h("div", { id: "island-clock", role: "img" }, time, date);
+  return {
+    el,
+    sync(now = new Date()) {
+      time.textContent = now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
+      date.textContent = now.toLocaleDateString([], { weekday: "short", day: "numeric", month: "short" });
+      el.style.setProperty("--clock-orbit", `${now.getMinutes() * 6}deg`);
+      el.title = t("Orbit: minutes within the hour");
+      el.setAttribute("aria-label", `${time.textContent} · ${date.textContent}. ${el.title}`);
+    },
+  };
+}
+
+export function buildCompactMusic(open: () => void, changed: () => void) {
+  const art = h("img", { class: "compact-art", alt: "" });
+  const title = h("span", { class: "compact-track" });
+  const artist = h("span", { class: "compact-artist" });
+  const wave = h("span", { class: "compact-wave", "aria-hidden": "true" },
+    ...Array.from({ length: 5 }, () => h("i")));
+  const el = h("button", { id: "compact-music", type: "button", onclick: () => open() },
+    art, h("span", { class: "compact-song" }, title, artist), wave);
+  let track: SpotifyTrack | null = null;
+  let artwork: string | null = null;
+  let blocked = false;
+  let playing = false;
+  let timer: number | null = null;
+  const view = {
+    el,
+    get visible() { return track != null && !blocked; },
+    sync(s: SpotifyState, active: boolean, priority: boolean) {
+      blocked = priority;
+      playing = active;
+      if (active && s.track) {
+        if (timer != null) window.clearTimeout(timer);
+        timer = null;
+        track = s.track;
+        artwork = currentArtwork(s);
+      } else if (track && timer == null) {
+        timer = window.setTimeout(() => {
+          timer = null;
+          track = null;
+          artwork = null;
+          paint();
+          changed();
+        }, 1000);
+      }
+      paint();
+    },
+  };
+  function paint() {
+    el.style.display = view.visible ? "flex" : "none";
+    el.classList.toggle("playing", playing && view.visible);
+    title.textContent = isAd(track) ? t("Advertisement") : track?.title ?? "";
+    artist.textContent = track?.artist ?? "";
+    el.setAttribute("aria-label", `${title.textContent} · ${artist.textContent}`);
+    if (artwork) art.setAttribute("src", artwork);
+    else art.removeAttribute("src");
+    art.style.visibility = artwork ? "visible" : "hidden";
+  }
+  paint();
+  return view;
+}

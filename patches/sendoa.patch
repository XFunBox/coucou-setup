--- /dev/null
+++ b/windows/src/core/task-history.ts
@@ -0,0 +1,58 @@
+/** Session-only observations. The caller chooses one canonical source per event class. */
+export type TaskHistoryKind =
+  | "tool_started" | "tool_finished" | "permission_requested"
+  | "turn_finished" | "turn_failed" | "turn_cancelled";
+
+export interface TaskHistoryEvent {
+  readonly source: "hook" | "codex";
+  readonly kind: TaskHistoryKind;
+  /** A real event ID, not a tool, turn or session ID shared by several events. */
+  readonly eventId?: string;
+  /** Epoch milliseconds from the source, if available; never synthesized. */
+  readonly timestamp?: number;
+}
+
+export const TASK_HISTORY_LIMIT = 20;
+const KINDS: readonly string[] = [
+  "tool_started", "tool_finished", "permission_requested",
+  "turn_finished", "turn_failed", "turn_cancelled",
+];
+
+/** Use the session/thread identity as the key, rather than a pill shared by chats. */
+export class TaskHistory {
+  private tasks = new Map<string, readonly TaskHistoryEvent[]>();
+
+  /** True when an observation was added and retained in the bounded history. */
+  record(taskId: string, input: TaskHistoryEvent): boolean {
+    if (!taskId.trim() || !KINDS.includes(input.kind) || !["hook", "codex"].includes(input.source)) return false;
+    const previous = this.tasks.get(taskId) ?? [];
+    const eventId = typeof input.eventId === "string" && input.eventId ? input.eventId : undefined;
+    // Deduplication covers retained events only: no unbounded set of old IDs.
+    if (eventId && previous.some(event => event.source === input.source && event.eventId === eventId)) return false;
+    const timestamp = typeof input.timestamp === "number" && Number.isFinite(input.timestamp)
+      && input.timestamp >= 0 && input.timestamp <= 8.64e15 ? input.timestamp : undefined;
+    // Whitelist metadata: a raw hook/bridge payload must never be retained here.
+    const event: TaskHistoryEvent = Object.freeze({
+      source: input.source, kind: input.kind,
+      ...(eventId === undefined ? {} : { eventId }),
+      ...(timestamp === undefined ? {} : { timestamp }),
+    });
+    const next = [...previous, event].sort((a, b) => {
+      // Unknown dates follow dated observations, in arrival order. Sorting is stable.
+      if (a.timestamp === undefined) return b.timestamp === undefined ? 0 : 1;
+      if (b.timestamp === undefined) return -1;
+      return a.timestamp - b.timestamp;
+    }).slice(-TASK_HISTORY_LIMIT);
+    this.tasks.set(taskId, next);
+    return next.includes(event);
+  }
+
+  get(taskId: string): readonly TaskHistoryEvent[] {
+    return [...(this.tasks.get(taskId) ?? [])];
+  }
+
+  clear(taskId: string): void { this.tasks.delete(taskId); }
+  clearAll(): void { this.tasks.clear(); }
+}
+
+export const taskHistory = new TaskHistory();

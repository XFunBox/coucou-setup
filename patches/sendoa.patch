+
+/* EVA agent room: hook-driven Mochis at individual desks. */
+.agent-room { padding: 0 16px 12px; display: flex; flex-direction: column; gap: 8px; }
+.room-heading { display: flex; align-items: center; justify-content: space-between; color: var(--eva-accent); font-size: 11px; font-weight: 700; letter-spacing: .08em; }
+.room-count { color: var(--eva-secondary); font-family: monospace; }
+.agent-room-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; overflow-y: auto; min-height: 0; flex: 1; align-content: start; padding: 2px; }
+.agent-desk { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 8px; border: 1px solid var(--eva-border); border-radius: 10px; background: linear-gradient(160deg, var(--eva-card), var(--eva-panel)); color: var(--eva-text); cursor: pointer; text-align: center; font: inherit; }
+.agent-desk:hover, .agent-desk:focus-visible { border-color: var(--eva-accent); outline: 2px solid var(--eva-accent); outline-offset: -2px; background: var(--eva-hover); }
+.agent-desk.selected { border-color: var(--eva-accent); }
+.desk-scene { display: block; position: relative; width: 100%; height: 106px; flex-shrink: 0; background: repeating-linear-gradient(0deg, transparent, transparent 15px, rgba(var(--eva-border-rgb), .12) 16px), repeating-linear-gradient(90deg, transparent, transparent 15px, rgba(var(--eva-border-rgb), .12) 16px); }
+.desk-monitor { position: absolute; width: 30px; height: 22px; left: calc(50% + 7px); top: 22px; border: 3px solid var(--eva-border); border-radius: 3px; background: var(--eva-bg); box-shadow: 0 0 12px rgba(var(--eva-accent-rgb), .09); }
+.desk-monitor::after { content: ''; display: block; margin: 4px; width: 12px; height: 2px; background: var(--eva-accent); box-shadow: 0 4px rgba(var(--eva-accent-rgb), .38); }
+.desk-surface { position: absolute; top: 56px; left: 16%; width: 68%; height: 7px; background: var(--eva-border); border-bottom: 3px solid var(--eva-hover); box-shadow: 0 13px 0 -2px var(--eva-hover); }
+.desk-worker { position: absolute; top: 57px; left: calc(50% - 32px); }
+.desk-name, .desk-status, .desk-step { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 17px; }
+.desk-name { font-size: 11px; font-weight: 650; }
+.desk-status { font-size: 10px; color: var(--eva-secondary); }
+.desk-step { font-size: 10px; color: var(--eva-secondary); }
+.agent-desk[data-state='working'] .desk-status, .agent-desk[data-state='finished'] .desk-status { color: var(--eva-accent); }
+.agent-desk[data-state='approval'] .desk-status, .agent-desk[data-state='question'] .desk-status, .agent-desk[data-state='ratelimit'] .desk-status { color: var(--eva-attention); }
+.agent-desk[data-state='error'] .desk-status { color: var(--eva-error); }
+.agent-desk[data-state='working'] .desk-monitor::after, .agent-desk[data-state='thinking'] .desk-monitor::after, .agent-desk[data-state='searching'] .desk-monitor::after { animation: desk-activity 1.4s steps(2, end) infinite; }
+.room-caption { font-size: 10px; color: var(--eva-secondary); }
+.room-empty { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--eva-secondary); font-size: 12px; }
+@keyframes desk-activity { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .agent-room * { animation: none !important; } }
+
+#compact-agent-status { position: absolute; top: 0; left: 64px; width: 164px; line-height: 32px; font-size: 10px; color: var(--eva-secondary); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; pointer-events: none; }
+
+.room-detail { white-space: pre-line; font-size: 11px; line-height: 18px; padding: 8px 12px; border-left: 2px solid var(--eva-accent); background: var(--eva-card); color: var(--eva-text); flex-shrink: 0; overflow-wrap: anywhere; }
+.agent-room-grid { background: repeating-linear-gradient(0deg, transparent, transparent 31px, rgba(var(--eva-border-rgb), .16) 32px), repeating-linear-gradient(90deg, transparent, transparent 31px, rgba(var(--eva-border-rgb), .16) 32px); border: 1px solid var(--eva-border); border-radius: 12px; padding: 14px; }
+@media (max-width: 650px) { .agent-room-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 6px; } }
+
+/* Codex desktop follower: reuse the existing chat card and EVA palette. */
+.chat-modes > .picker-chips { padding: 0 8px 5px; }
+.chat-modes.on { display: flex; flex-direction: column; }
+.chat-modes > .view { display: block; position: relative; inset: auto; flex: 1; min-height: 0; }

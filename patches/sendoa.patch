+// A follower of an explicitly selected desktop chat. No local conversation copy.
+import { h, clear } from "./dom";
+import { renderMarkdown } from "./markdown";
+import { Bridge, type CodexChatSnapshot } from "../core/bridge";
+
+export function buildCodexChat(onHeightChange: () => void) {
+  const threads = h("div", { class: "codex-threads" });
+  const log = h("div", { class: "chat-log", role: "log", "aria-label": "Historial de Codex" });
+  const status = h("div", { class: "codex-status", role: "status", text: "Selecciona un chat abierto en Codex." });
+  const input = h("input", { class: "chat-input codex-input", type: "text", placeholder: "Escribir en el chat seleccionado…", "aria-label": "Mensaje para Codex" }) as HTMLInputElement;
+  const send = h("button", { class: "codex-send chat-mode-btn", text: "Enviar" });
+  const stop = h("button", { class: "codex-stop chat-mode-btn", text: "Detener" });
+  const choose = h("button", { class: "picker-link", text: "Cambiar chat" });
+  const open = h("button", { class: "picker-link", text: "Abrir en Codex" });
+  const title = h("span", { class: "codex-title", text: "Codex escritorio · experimental" });
+  const el = h("div", { class: "card wash codex-chat" },
+    h("div", { class: "codex-toolbar" }, title, choose, open), threads, log, status,
+    h("div", { class: "chat-bar" }, input, send, stop));
+  let threadId: string | null = null;
+  let snapshot: CodexChatSnapshot | null = null;
+  let visible = false;
+  let busy = false;
+  let refreshing = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let generation = 0;
+  let lastMessages = "";
+  let actionWarning = "";
+  const drafts = new Map<string, string>();
+
+  function buttons() {
+    input.disabled = busy || !snapshot || snapshot.active || snapshot.pending;
+    send.disabled = input.disabled || refreshing;
+    stop.disabled = busy || refreshing || !snapshot?.activeTurnId;
+    choose.disabled = busy || refreshing;
+    open.disabled = !threadId;
+  }
+  function cancelPoll() { clearTimeout(timer); timer = undefined; }
+  function schedule() {
+    cancelPoll();
+    if (visible && threadId) timer = setTimeout(() => void refresh(), 2500);
+  }
+  async function refresh() {
+    if (!visible || !threadId || busy || refreshing) return;
+    const ticket = generation;
+    refreshing = true;
+    buttons();
+    try {
+      const next = await Bridge.codexChatSnapshot(threadId);
+      if (ticket !== generation) return;
+      snapshot = next;
+      const key = JSON.stringify(next.messages);
+      if (key !== lastMessages) {
+        lastMessages = key;
+        const atBottom = log.scrollTop + log.clientHeight >= log.scrollHeight - 40;
+        clear(log);
+        for (const message of next.messages) {
+          const content = h("div", { class: message.role === "user" ? "bubble" : "reply" });
+          if (message.role === "user") content.textContent = message.content;
+          else renderMarkdown(content, message.content);
+          log.append(h("div", { class: message.role === "user" ? "chat-row user" : "chat-row" }, content));
+        }
+        if (atBottom || log.scrollTop === 0) log.scrollTop = log.scrollHeight;
+        onHeightChange();
+      }
+      status.textContent = next.pending ? "Codex requiere tu decisión. Abre el chat completo para responder." :
+        next.active ? "Codex está trabajando…" : "Conectado al chat seleccionado.";
+      if (next.truncated) status.textContent += " Se muestra solo el historial reciente.";
+      if (actionWarning) status.textContent += ` ${actionWarning}`;
+    } catch (error) {
+      if (ticket !== generation) return;
+      snapshot = null;
+      status.textContent = String(error).replace(/^Error:\s*/, "");
+    } finally {
+      refreshing = false;
+      buttons();
+      if (ticket === generation) schedule();
+    }
+  }
+  async function list() {
+    cancelPoll();
+    generation++;
+    if (threadId) drafts.set(threadId, input.value);
+    threadId = null;
+    input.value = "";
+    title.textContent = "Codex escritorio · experimental";
+    snapshot = null;
+    lastMessages = "";
+    actionWarning = "";
+    clear(log);
+    clear(threads);
+    buttons();
+    status.textContent = "Selecciona un chat abierto en Codex. Las decisiones se responden en Codex.";
+    try {
+      const ticket = generation;
+      const entries = await Bridge.codexChatThreads();
+      if (!visible || ticket !== generation) return;
+      for (const entry of entries) {
+        const button = h("button", { class: "picker-model codex-thread", text: entry.title, title: entry.id });
+        button.addEventListener("click", () => {
+          generation++;
+          threadId = entry.id;
+          input.value = drafts.get(entry.id) ?? "";
+          title.textContent = `Codex · ${entry.title}`;
+          clear(threads);
+          status.textContent = "Conectando…";
+          void refresh();
+        });
+        threads.append(button);
+      }
+      if (!entries.length) status.textContent = "No hay chats locales. Abre un chat en Codex primero.";
+    } catch (error) { status.textContent = String(error); }
+  }
+  async function action(interrupt: boolean) {
+    const query = input.value.trim();
+    if (!threadId || busy || refreshing || (interrupt ? !snapshot?.activeTurnId : !query || send.disabled)) return;
+    cancelPoll();
+    busy = true;
+    actionWarning = "";
+    buttons();
+    try {
+      if (interrupt) await Bridge.codexChatInterrupt(threadId, snapshot!.activeTurnId!);
+      else {
+        await Bridge.codexChatSend(threadId, query);
+        input.value = "";
+      }
+      status.textContent = interrupt ? "Interrupción solicitada." : "Mensaje entregado a Codex.";
+    } catch (error) {
+      // An uncertain acknowledgement must never cause an automatic resend.
+      snapshot = null;
+      actionWarning = `${String(error).replace(/^Error:\s*/, "")} Comprueba el chat en Codex antes de volver a enviar.`;
+      status.textContent = actionWarning;
+      busy = false;
+      buttons();
+      schedule();
+      return;
+    }
+    busy = false;
+    await refresh();
+    if (visible) input.focus();
+  }
+  choose.addEventListener("click", () => void list());
+  open.addEventListener("click", () => { if (threadId) void Bridge.codexChatOpen(threadId).catch(error => { status.textContent = String(error); }); });
+  send.addEventListener("click", () => void action(false));
+  stop.addEventListener("click", () => void action(true));
+  input.addEventListener("keydown", event => {
+    if ((event as KeyboardEvent).key === "Enter") { event.preventDefault(); void action(false); }
+    event.stopPropagation();
+  });
+  buttons();
+  return { el, focus: () => input.focus(), setVisible(on: boolean) {
+    if (visible === on) return;
+    visible = on;
+    cancelPoll();
+    if (on) { if (threadId) void refresh(); else void list(); }
+  } };
+}

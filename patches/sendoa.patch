+/// Personal dashboard, independent of PR/GraphQL permissions.
+#[derive(Serialize, Clone, Debug, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct GitHubDashboard {
+    pub login: String,
+    pub repositories: Vec<GitHubRepository>,
+    pub commits: Vec<GitHubCommit>,
+    pub pipelines: Vec<GitHubPipeline>,
+    pub commits_unavailable: usize,
+    pub pipelines_unavailable: usize,
+    pub truncated: bool,
+    pub fetched_at: u64,
+}
+
+#[derive(Serialize, Clone, Debug)]
+#[serde(rename_all = "camelCase")]
+pub struct GitHubRepository {
+    pub repo: String,
+    pub url: String,
+    pub description: String,
+    pub private: bool,
+    pub archived: bool,
+    pub branch: String,
+    pub pushed_at: String,
+}
+
+impl GitHubRepository {
+    pub fn parse(value: &Value) -> Option<Self> {
+        let repo = str_at(value, "full_name")?;
+        // Only repository names can form API routes, never URLs from a response.
+        let parts: Vec<_> = repo.split('/').collect();
+        if parts.len() != 2 || parts.iter().any(|s| s.is_empty() || s.chars().any(|c| !c.is_ascii_alphanumeric() && !"-_.".contains(c))) {
+            return None;
+        }
+        Some(Self {
+            repo: repo.into(), url: str_at(value, "html_url")?.into(),
+            description: str_at(value, "description").unwrap_or_default().into(),
+            private: value["private"].as_bool().unwrap_or(false),
+            archived: value["archived"].as_bool().unwrap_or(false),
+            branch: str_at(value, "default_branch").unwrap_or_default().into(),
+            pushed_at: str_at(value, "pushed_at").unwrap_or_default().into(),
+        })
+    }
+}
+
+#[derive(Serialize, Clone, Debug)]
+#[serde(rename_all = "camelCase")]
+pub struct GitHubCommit {
+    pub repo: String, pub url: String, pub sha: String,
+    pub message: String, pub author: String, pub date: String,
+}
+
+impl GitHubCommit {
+    pub fn parse(repo: &str, value: &Value) -> Option<Self> {
+        let commit = value.get("commit")?;
+        Some(Self {
+            repo: repo.into(), url: str_at(value, "html_url")?.into(), sha: str_at(value, "sha")?.into(),
+            message: str_at(commit, "message")?.lines().next().unwrap_or_default().into(),
+            author: commit["author"]["name"].as_str().unwrap_or_default().into(),
+            date: commit["committer"]["date"].as_str().or_else(|| commit["author"]["date"].as_str()).unwrap_or_default().into(),
+        })
+    }
+}
+
+#[derive(Serialize, Clone, Debug)]
+#[serde(rename_all = "camelCase")]
+pub struct GitHubPipeline {
+    pub repo: String, pub url: String, pub name: String, pub branch: String,
+    pub status: String, pub started_at: String,
+}
+
+impl GitHubPipeline {
+    pub fn parse(repo: &str, value: &Value) -> Option<Self> {
+        // Never label a completed workflow as running, even on stale/API fixtures.
+        if str_at(value, "status")? != "in_progress" { return None; }
+        Some(Self {
+            repo: repo.into(), url: str_at(value, "html_url")?.into(),
+            name: str_at(value, "name").unwrap_or("GitHub Actions").into(),
+            branch: str_at(value, "head_branch").unwrap_or_default().into(), status: "in_progress".into(),
+            started_at: str_at(value, "run_started_at").or_else(|| str_at(value, "created_at")).unwrap_or_default().into(),
+        })
+    }
+}

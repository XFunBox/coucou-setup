+pub fn snapshot(thread: &str) -> Result<Snapshot, String> {
+    validate_thread(thread)?;
+    #[cfg(target_os = "linux")] { ipc::Client::new(thread)?.snapshot() }
+    #[cfg(not(target_os = "linux"))] { Err("El chat compartido de Codex requiere Linux.".into()) }
+}
+pub fn send(thread: &str, query: &str) -> Result<(), String> {
+    validate_thread(thread)?;
+    if query.trim().is_empty() || query.len() > MAX_QUERY { return Err("Escribe un mensaje de hasta 32768 bytes.".into()); }
+    #[cfg(target_os = "linux")] { ipc::Client::new(thread)?.start(query) }
+    #[cfg(not(target_os = "linux"))] { Err("El chat compartido de Codex requiere Linux.".into()) }
+}
+pub fn interrupt(thread: &str, expected: &str) -> Result<(), String> {
+    validate_thread(thread)?;
+    if expected.is_empty() || expected.len() > 256 || expected.chars().any(char::is_control) { return Err("Identificador de turno inválido.".into()); }
+    #[cfg(target_os = "linux")] { ipc::Client::new(thread)?.interrupt(expected) }
+    #[cfg(not(target_os = "linux"))] { Err("El chat compartido de Codex requiere Linux.".into()) }
+}

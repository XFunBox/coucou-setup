@@ -0,0 +1,65 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { selectCompactNotice, buildCompactNotice } from '../src/island/notice.ts';
+import { installFakeDom } from './fakedom.mjs';
+const task = (id, state) => ({id, name: id, state});
+test('pending permission wins without losing other notices; selection stays stable by priority', () => {
+  const tasks = [task('finished','finished'),task('error','error'),task('other','approval')];
+  const pending = {pillId:'request', requestId:'one', questions:null};
+  const first = selectCompactNotice(tasks, pending);
+  assert.equal(first.pillId,'request'); assert.equal(first.requestId,'one'); assert.equal(first.count,4);
+  assert.equal(selectCompactNotice(tasks,null).pillId,'other');
+  tasks.pop(); assert.equal(selectCompactNotice(tasks,null).pillId,'error');
+  tasks.pop(); assert.equal(selectCompactNotice(tasks,null).pillId,'finished');
+  assert.equal(selectCompactNotice([task('idle','idle')],null),null);
+});
+test('one task creates one notice and a pending request is not counted twice', () => {
+  const pending={pillId:'same',requestId:'real'};
+  const result=selectCompactNotice([task('same','approval'),task('same','error')],pending);
+  assert.equal(result.count,1); assert.equal(result.requestId,'real');
+});
+test('compact notice click opens the exact displayed item and never responds', () => {
+  installFakeDom(); let opened=[];
+  const view=buildCompactNotice(item => opened.push(item));
+  const notice=selectCompactNotice([task('A','error')],null);
+  view.sync(notice); view.el.fire('click');
+  assert.equal(opened[0].pillId,'A'); assert.match(view.el.getAttribute('aria-label'),/A/);
+  view.sync(null); view.el.fire('click'); assert.equal(opened.length,1);
+  assert.equal(view.el.style.display,'none');
+});
+test('flow completion notices expire and interruption is not called an error', () => {
+  const now=Date.now();
+  assert.equal(selectCompactNotice([{...task('old','finished'),flow:{lastSeen:new Date(now-10000).toISOString()}}],null),null);
+  assert.equal(selectCompactNotice([{...task('new','finished'),flow:{lastSeen:new Date(now).toISOString()}}],null).pillId,'new');
+  assert.equal(selectCompactNotice([{...task('cancelled','error'),flow:{status:'interrupted'}}],null),null);
+});
+
+import { Island } from '../src/island/island.ts';
+import { State } from '../src/core/state.ts';
+test('opening a stale request cannot open or answer its replacement', () => {
+  const saved = State.pendingApproval;
+  const current = {pillId:'A',requestId:'new',state:'approval'};
+  const opened=[];
+  const host={currentNotice:()=>current,setView:view=>opened.push(view)};
+  State.pendingApproval={pillId:'A',requestId:'new',sessionId:'real'};
+  const focus=State.setFocus;
+  try {
+    State.setFocus=id=>opened.push(id);
+    Island.prototype.openCompactNotice.call(host,{...current,requestId:'old'});
+    assert.deepEqual(opened,[]);
+    Island.prototype.openCompactNotice.call(host,current);

+        #[test] fn socket_permissions_and_type_are_required() {
+            use std::os::unix::fs::PermissionsExt;
+            let dir = std::env::temp_dir().join(unique()); std::fs::create_dir(&dir).unwrap();
+            std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700)).unwrap();
+            let path = dir.join("ipc.sock"); let _server = std::os::unix::net::UnixListener::bind(&path).unwrap();
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).unwrap();
+            let uid = unsafe { libc::geteuid() };
+            assert!(secure(&std::fs::symlink_metadata(&path).unwrap(), uid, true));
+            assert!(!secure(&std::fs::symlink_metadata(&path).unwrap(), uid + 1, true));
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o666)).unwrap();
+            assert!(!secure(&std::fs::symlink_metadata(&path).unwrap(), uid, true));
+            let link = dir.join("link"); std::os::unix::fs::symlink(&path, &link).unwrap();
+            assert!(!secure(&std::fs::symlink_metadata(&link).unwrap(), uid, true));

@@ -0,0 +1,23 @@
+import { emitToWindow, onEvent } from "../core/bridge";
+import { t } from "../i18n/i18n";
+import type { FlowPageRenderer } from "../hub/shell";
+import type { OfficeSnapshot } from "./model";
+import { officeView } from "./view";
+
+export const officePage: FlowPageRenderer = async (container, ctx) => {
+  const view = officeView((request) => void emitToWindow("island", "office-open", request));
+  container.append(ctx.hero("office", t("Agent office"), t("A live workspace for your agents. Select a desk for details or to answer a question.")), view.root);
+  view.update({ agents: [], pending: null });
+  let left = false;
+  let unlisten: (() => void) | undefined;
+  ctx.onLeave = () => {
+    left = true;
+    unlisten?.();
+    void emitToWindow("island", "office-watch", false);
+  };
+  unlisten = await onEvent<OfficeSnapshot>("office-snapshot", (scene) => {
+    if (!left && scene && Array.isArray(scene.agents)) view.update(scene);
+  });
+  if (left) { unlisten(); return; }
+  await emitToWindow("island", "office-watch", true);
+};

diff --git a/windows/scripts/codex-bridge.mjs b/windows/scripts/codex-bridge.mjs
new file mode 100644
index 0000000..b3d8439
--- /dev/null
+++ b/windows/scripts/codex-bridge.mjs
@@ -0,0 +1,206 @@
+#!/usr/bin/env node
+// Owned stdio App Server session. Never attaches to another client's Desktop chat.
+import { spawn } from 'node:child_process';
+import { createInterface } from 'node:readline';
+import { pathToFileURL } from 'node:url';
+
+function launch(executable, args, options) {
+  // npm installations may expose Codex as a JS entry point. Avoid a shell,
+  // preserving spaces and shell metacharacters in prompts and paths verbatim.
+  return /\.[cm]?js$/i.test(executable) ? spawn(process.execPath, [executable, ...args], options) : spawn(executable, args, options);
+}
+
+function questionsFor(params) {
+  const questions = params?.questions;
+  if (!Array.isArray(questions) || !questions.length || questions.length > 3) throw Error('Unsupported question count');
+  const ids = new Set(), texts = new Set();
+  for (const q of questions) {
+    if (!q || typeof q.id !== 'string' || !q.id || ids.has(q.id) || typeof q.question !== 'string' || !q.question || q.question.endsWith('…') || texts.has(q.question) || q.isSecret || !Array.isArray(q.options) || q.options.length < 2) throw Error('Unsupported or ambiguous question');
+    if (Buffer.byteLength(q.question) > 1900 || q.options.some(o => typeof o?.label !== 'string' || !o.label || Buffer.byteLength(o.label) > 1900 || o.label.endsWith('…')) || new Set(q.options.map(o => o.label)).size !== q.options.length) throw Error('Unsupported options');
+    ids.add(q.id); texts.add(q.question);
+  }
+  return questions;
+}
+
+/** One visible island card at a time, correlated to the server's original id. */
+export function createQuestionRouter({ ask, send, event = () => {}, timeoutMs = 105_000 }) {
+  const pending = new Map();
+  let tail = Promise.resolve();
+  function resolve({ threadId, requestId }) {
+    const entry = pending.get(requestId);
+    if (!entry || entry.params.threadId !== threadId) return;
+    entry.cancel();
+  }
+  function handle(message) {
+    if (pending.has(message.id)) return Promise.resolve();
+    const controller = new AbortController();
+    const expires = Math.min(timeoutMs, typeof message.params?.autoResolutionMs === 'number' ? Math.max(0, message.params.autoResolutionMs) : timeoutMs);
+    const entry = { params: message.params, deadline: Date.now() + expires, cancelled: false, cancel() { this.cancelled = true; controller.abort(); } };
+    pending.set(message.id, entry);
+    const run = async () => {
+      let timer;
+      const identity = { session_id: message.params?.threadId ?? '', coucou_agent: 'codex', coucou_question_id: String(message.id) };
+      try {
+        if (entry.cancelled) return;
+        const isQuestion = message.method === 'item/tool/requestUserInput';
+        const isCommand = message.method === 'item/commandExecution/requestApproval';
+        if (!isQuestion && !isCommand && message.method !== 'item/fileChange/requestApproval') throw Error('Unsupported request');
+        const questions = isQuestion ? questionsFor(message.params) : null;
+        const params = message.params;
+        if (!params?.threadId || !params.turnId || !params.itemId) throw Error('Missing request identity');
+        const approvalPreview = isQuestion ? '' : JSON.stringify(params);
+        if (Buffer.byteLength(approvalPreview) > 1900) throw Error('Approval context exceeds the island preview limit');
+        const remaining = entry.deadline - Date.now();
+        if (remaining <= 0) throw Error('Request expired while queued');
+        const payload = { ...identity, cwd: params.cwd ?? '', hook_event_name: 'PermissionRequest', coucou_question_bridge: true,
+          tool_name: isQuestion ? 'AskUserQuestion' : isCommand ? 'Bash' : 'Codex file change',
+          // One complete preview: the existing approval card prioritizes the
+          // command field, so keep requested access/reason in that field too.
+          tool_input: isQuestion ? { questions: questions.map(q => ({ question: q.question, options: q.options, multiSelect: false })) } : { command: approvalPreview },
+        };
+        const cancelled = new Promise((_, reject) => controller.signal.addEventListener('abort', () => reject(Error('Question cancelled')), { once: true }));
+        const answer = await Promise.race([
+          ask(payload, controller.signal),
+          new Promise((_, reject) => { timer = setTimeout(() => reject(Error('Request timed out')), remaining); }), cancelled,
+        ]);
+        if (entry.cancelled) return;
+        if (!isQuestion) {
+          if (answer?.decision !== 'allow' && answer?.decision !== 'deny') throw Error('No explicit approval decision from Coucou');
+          const decision = answer.decision === 'allow' ? 'accept' : 'decline';
+          if (Array.isArray(params.availableDecisions) && !params.availableDecisions.includes(decision)) throw Error('Decision not offered by Codex');
+          send({ id: message.id, result: { decision } });
+          return;
+        }
+        if (!answer?.answers || Object.keys(answer.answers).length !== questions.length) throw Error('No complete answer from Coucou');
+        const answers = Object.create(null);
+        for (const q of questions) {
+          const label = answer.answers[q.question];
+          if (typeof label !== 'string' || !q.options.some(o => o.label === label)) throw Error('Answer is not an offered option');
+          answers[q.id] = { answers: [label] };
+        }
+        send({ id: message.id, result: { answers: { ...answers } } });
+      } catch (error) {
+        if (!entry.cancelled) send({ id: message.id, error: { code: -32000, message: error.message } });
+      } finally {
+        clearTimeout(timer);
+        controller.abort();
+        pending.delete(message.id);
+        event({ ...identity, hook_event_name: 'QuestionResolved' });
+      }
+    };
+    const result = tail.then(run);
+    tail = result.catch(() => {});
+    return result;
+  }
+  return { handle, resolve, cancelAll() { for (const entry of pending.values()) entry.cancel(); } };
+}
+
+export function relayEvent(executable, payload, signal) {
+  return new Promise((resolve, reject) => {
+    const child = launch(executable, ['--agent', 'codex-bridge', payload.hook_event_name], { windowsHide: true, stdio: ['pipe', 'pipe', 'inherit'], signal });
+    let output = '';
+    child.stdout.setEncoding('utf8');
+    child.stdout.on('data', text => { output += text; if (output.length > 256_000) child.kill(); });
+    child.on('error', reject);
+    child.on('close', () => { try { resolve(output.trim() ? JSON.parse(output) : null); } catch { reject(Error('Invalid Coucou relay response')); } });
+    child.stdin.on('error', () => {});
+    child.stdin.end(JSON.stringify(payload));
+  });
+}
+
+/** Small JSON-lines client, also exercised by the local protocol harness. */
+export function createClient(child, { relay, output = text => process.stdout.write(text), onComplete = () => {} }) {
+  const waiting = new Map();
+  const finalLines = new Map();
+  let nextId = 1;
+  const send = value => child.stdin.write(JSON.stringify(value) + '\n');
+  const event = payload => { void relay(payload).catch(() => {}); };
+  const router = createQuestionRouter({ ask: relay, send, event });
+  const rpc = (method, params) => new Promise((resolve, reject) => {
+    const id = nextId++;
+    const timer = setTimeout(() => { waiting.delete(id); reject(Error(`${method} timed out`)); }, 30_000);
+    waiting.set(id, { resolve, reject, timer }); send({ id, method, params });
+  });
+  const lines = createInterface({ input: child.stdout });
+  lines.on('line', line => {
+    let message;
+    try { message = JSON.parse(line); } catch { return; }
+    const p = message.params ?? {};
+    if (!message.method && waiting.has(message.id)) {
+      const entry = waiting.get(message.id); waiting.delete(message.id); clearTimeout(entry.timer);
+      if (message.error) entry.reject(Error(message.error.message)); else entry.resolve(message.result);
+      return;
+    }
+    if (message.id != null && message.method) {
+      if (message.method === 'item/tool/requestUserInput' || /^item\/(commandExecution|fileChange)\/requestApproval$/.test(message.method)) void router.handle(message);
+      else send({ id: message.id, error: { code: -32601, message: 'Unsupported Coucou client request' } });
+      return;
+    }
+    if (message.method === 'serverRequest/resolved') router.resolve(p);
+    const identity = { coucou_agent: 'codex', session_id: p.threadId ?? p.thread?.id ?? '', cwd: p.cwd ?? '' };
+    if (message.method === 'thread/started') event({ ...identity, hook_event_name: 'SessionStart', cwd: p.thread?.cwd ?? '' });
+    if (message.method === 'turn/started') { finalLines.delete(identity.session_id); event({ ...identity, hook_event_name: 'UserPromptSubmit' }); }
+    if (message.method === 'item/started' && p.item?.type !== 'agentMessage') event({ ...identity, hook_event_name: 'PreToolUse', tool_name: p.item?.type ?? 'Tool', tool_input: { command: p.item?.command ?? '' } });
+    if (message.method === 'item/agentMessage/delta') output(p.delta ?? '');
+    if (message.method === 'item/completed' && p.item?.type === 'agentMessage' && typeof p.item.text === 'string') finalLines.set(identity.session_id, p.item.text.slice(0, 1800));
+    if (message.method === 'turn/completed') {
+      router.cancelAll();
+      event({ ...identity, hook_event_name: p.turn?.status === 'failed' ? 'StopFailure' : p.turn?.status === 'interrupted' ? 'Interrupt' : 'Stop', last_assistant_message: finalLines.get(identity.session_id) ?? '' });
+      finalLines.delete(identity.session_id);
+      onComplete(p);
+    }
+  });
+  child.on('error', close);
+  child.on('exit', () => close(Error('Codex App Server exited')));
+  function close(error = Error('Codex bridge closed')) {
+    router.cancelAll(); lines.close();
+    for (const entry of waiting.values()) { clearTimeout(entry.timer); entry.reject(error); }
+    waiting.clear();
+  }
+  return { rpc, send, close };
+}
+
+async function main(args) {
+  if (args.includes('--help') || !args.length) {
+    console.log('Usage: node codex-bridge.mjs [--cwd DIR] [--codex EXE_OR_JS] [--hook EXE_OR_JS] [--model MODEL] [--plan] PROMPT\nCreates an independent Codex App Server session; Coucou must be open. Requires Node 22+, Codex CLI sign-in and coucou-hook. Supports fixed-choice questions and command/file approvals. Default sandbox: workspace-write, approval: on-request.');
+    return;
+  }
+  const config = { cwd: process.cwd(), codex: process.platform === 'win32' ? 'codex.exe' : 'codex', hook: process.platform === 'win32' ? 'coucou-hook.exe' : 'coucou-hook' };
+  const prompt = [];
+  for (let i = 0; i < args.length; i++) {
+    const key = args[i].slice(2);
+    if (['cwd', 'codex', 'hook', 'model'].includes(key) && args[i].startsWith('--')) { if (!args[i+1]) throw Error(`Missing ${args[i]}`); config[key] = args[++i]; }
+    else if (args[i] === '--plan') config.plan = true;
+    else if (args[i].startsWith('--')) throw Error(`Unknown option ${args[i]}`);
+    else prompt.push(args[i]);
+  }
+  if (!prompt.length) throw Error('A prompt is required');
+  const child = launch(config.codex, ['app-server'], { cwd: config.cwd, windowsHide: true, stdio: ['pipe', 'pipe', 'inherit'] });
+  let complete;
+  const completed = new Promise(resolve => { complete = resolve; });
+  const client = createClient(child, { relay: (payload, signal) => relayEvent(config.hook, { ...payload, cwd: payload.cwd || config.cwd }, signal), onComplete: complete });
+  child.on('exit', code => complete({ turn: { status: 'failed', error: { message: `Codex exited (${code})` } } }));
+  child.on('error', error => complete({ turn: { status: 'failed', error } }));
+  const interrupt = () => { client.close(); child.kill(); };
+  process.once('SIGINT', interrupt);
+  try {
+    await client.rpc('initialize', { clientInfo: { name: 'coucou_bridge', version: '1' }, capabilities: { experimentalApi: true } });
+    client.send({ method: 'initialized', params: {} });
+    // Pinned wire enum (different from SandboxPolicy's camelCase variant):
+    // https://github.com/openai/codex/blob/rust-v0.159.2/codex-rs/app-server-protocol/schema/typescript/v2/SandboxMode.ts
+    const started = await client.rpc('thread/start', { cwd: config.cwd, approvalPolicy: 'on-request', sandbox: 'workspace-write', ...(config.model ? { model: config.model } : {}) });
+    console.error(`Coucou Codex thread: ${started.thread.id}`);
+    const turn = { threadId: started.thread.id, input: [{ type: 'text', text: prompt.join(' ') }] };
+    if (config.plan) {
+      const model = config.model ?? started.model;
+      if (!model) throw Error('--plan requires --model when server does not report its model');
+      turn.collaborationMode = { mode: 'plan', settings: { model, reasoning_effort: 'medium', developer_instructions: null } };
+    }
+    await client.rpc('turn/start', turn);
+    const result = await completed;
+    if (result.turn?.status === 'failed') throw Error(result.turn?.error?.message ?? 'Codex turn failed');
+    console.log();
+  } finally { process.removeListener('SIGINT', interrupt); client.close(); child.stdin.end(); child.kill(); }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) main(process.argv.slice(2)).catch(error => { console.error(error.message); process.exitCode = 1; });

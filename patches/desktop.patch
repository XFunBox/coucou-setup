new file mode 100644
index 0000000..945a8f6
--- /dev/null
+++ b/windows/src/office/relay.ts
@@ -0,0 +1,39 @@
+import { State } from "../core/state";
+import { emitToWindow, onEvent } from "../core/bridge";
+import type { Island } from "../island/island";
+import { requestForAgent, type OfficeOpen, type OfficeSnapshot } from "./model";
+
+export function officeSnapshot(): OfficeSnapshot {
+  const req = State.pendingApproval;
+  return {
+    agents: State.officeAgents.map((a) => ({ ...a })),
+    pending: req ? { requestId: req.requestId, sessionId: req.sessionId, pillId: req.pillId, command: req.command, questions: req.questions } : null,
+  };
+}
+
+/** The two webviews have different JS globals: the island owns live state. */
+export async function registerOfficeRelay(island: Island) {
+  let watching = false;
+  let last = "";
+  const publish = () => {
+    if (!watching) return;
+    const scene = officeSnapshot();
+    const next = JSON.stringify(scene);
+    if (next === last) return;
+    last = next;
+    void emitToWindow("settings", "office-snapshot", scene);
+  };
+  State.subscribe(publish);
+  await onEvent<boolean>("office-watch", (on) => { watching = on === true; last = ""; publish(); });
+  await onEvent<OfficeOpen>("office-open", (input) => {
+    if (!input || typeof input.agentId !== "string") return;
+    const scene = officeSnapshot();
+    const agent = scene.agents.find((a) => a.id === input.agentId);
+    if (!agent) return;
+    const req = requestForAgent(scene, agent);
+    // A stale bubble can never open/answer a different session's request.
+    if (!input.requestId || req?.requestId !== input.requestId) return;
+    State.setFocus(agent.pillId);
+    island.alert(req.questions ? "question" : "approval");
+  });
+}
diff --git a/windows/src/office/view.ts b/windows/src/office/view.ts
new file mode 100644
index 0000000..8b61064
--- /dev/null
+++ b/windows/src/office/view.ts
@@ -0,0 +1,92 @@
+import { h, clear } from "../views/dom";
+import { t } from "../i18n/i18n";
+import { officeStatus, requestForAgent, type OfficeOpen, type OfficeSnapshot } from "./model";
+
+/** Original CSS pixel characters. No images, canvas loop or synthetic sessions. */
+export function officeView(onOpen: (request: OfficeOpen) => void) {
+  const root = h("section", { class: "office", "aria-label": t("Agent office") });
+  const summary = h("p", { class: "office-summary", role: "status", "aria-live": "polite" });
+  const room = h("div", { class: "office-room", role: "list", "aria-label": t("Live sessions") });
+  const details = h("section", { class: "office-details", "aria-label": t("Details"), hidden: true });
+  root.append(summary, room, details);
+  let fingerprint = "";
+  let current: OfficeSnapshot = { agents: [], pending: null };
+  let selected: string | null = null;
+  let buttons = new Map<string, HTMLButtonElement>();
+
+  function drawDetails(focus = false) {
+    const agent = current.agents.find((a) => a.id === selected);
+    clear(details);
+    if (!agent) { details.setAttribute("hidden", ""); selected = null; return; }
+    details.removeAttribute("hidden");
+    const heading = h("h2", { text: agent.name, tabindex: -1 });
+    details.append(heading,
+      h("p", { text: officeStatus(agent, !!requestForAgent(current, agent)) }),
+      h("p", { class: "office-detail-project", text: agent.project }),
+      h("code", { text: agent.cwd }),
+      h("p", { class: "office-detail-id", text: `${t("Session")}: ${agent.sessionId}${agent.subagentId ? ` · ${t("Subagent")}: ${agent.subagentId}` : ""}` }),
+      h("p", { text: agent.step || t("Waiting for activity") }));
+    if (agent.finalLine) details.append(h("h3", { text: t("Result") }), h("p", { text: agent.finalLine }));
+    details.append(h("button", { type: "button", class: "hub-btn small", text: t("Close"), onclick: () => {
+      const previous = selected;
+      selected = null;
+      drawDetails();
+      if (previous) buttons.get(previous)?.focus();
+    } }));
+    if (focus) heading.focus();
+  }
+
+  function update(scene: OfficeSnapshot) {
+    // Unrelated island animation/state updates must not replace focused buttons.
+    const next = JSON.stringify(scene);
+    if (next === fingerprint) return;
+    fingerprint = next;
+    current = scene;
+    const active = document.activeElement as HTMLElement | null;
+    const focused = active && room.contains?.(active) ? active.dataset.officeAgent : undefined;
+    buttons = new Map<string, HTMLButtonElement>();
+    clear(room);
+    const waiting = scene.agents.filter((a) => requestForAgent(scene, a)).length;
+    summary.textContent = `${scene.agents.length} ${t("live sessions")} · ${waiting} ${t("waiting for you")}`;
+    if (!scene.agents.length) {
+      room.append(h("div", { class: "office-empty" },
+        h("span", { class: "office-empty-icon", "aria-hidden": "true", text: "▤" }),
+        h("h2", { text: t("Your office is ready") }),
+        h("p", { text: t("Start an agent with Coucou hooks enabled. Real sessions and subagents will appear here.") })));
+      drawDetails();
+      return;
+    }
+    for (const agent of scene.agents) {
+      const pending = requestForAgent(scene, agent);
+      const status = officeStatus(agent, !!pending);
+      const action = pending ? t("Open answer card") : t("Details");
+      const button = h("button", {
+        type: "button", class: `office-desk ${pending ? "needs-answer" : ""}`,
+        "aria-label": `${agent.name} · ${status} · ${action}`,
+        onclick: () => {
+          if (pending) onOpen({ agentId: agent.id, requestId: pending.requestId });
+          else { selected = agent.id; drawDetails(true); }
+        },
+      });
+      button.dataset.officeAgent = agent.id;
+      button.dataset.state = agent.state;
+      // The palette is fixed, not injected hook data.
+      button.style.setProperty("--office-agent", agent.subagentId ? "#e6b978" : "#9cbbad");
+      if (pending) button.append(h("span", { class: "office-bubble", text: pending.questions?.[0]?.question || pending.command || t("Needs approval") }));
+      const art = h("span", { class: "office-workspace", "aria-hidden": "true" },
+        h("span", { class: "office-monitor" }, h("span", { text: agent.state === "finished" ? "✓" : ">_" })),
+        h("span", { class: "office-person" }, h("i", { class: "office-eyes" })),
+        h("span", { class: "office-table" }), h("span", { class: "office-plant", text: "✚" }));
+      button.append(art, h("span", { class: "office-name", text: agent.name }),
+        h("span", { class: "office-project", text: agent.project || (agent.subagentId ? t("Subagent") : t("Session")) }),
+        h("span", { class: "office-state", text: status }),
+        h("span", { class: "office-step", text: agent.finalLine || agent.step || t("Waiting for activity") }),
+        h("span", { class: "office-action", text: action }));
+      room.append(h("div", { class: "office-seat", role: "listitem" }, button));
+      buttons.set(agent.id, button);
+    }
+    drawDetails(!!active && !!details.contains?.(active));
+    if (focused) buttons.get(focused)?.focus();
+  }
+  return { root, update };
+}
diff --git a/windows/tests/codex-bridge.test.mjs b/windows/tests/codex-bridge.test.mjs

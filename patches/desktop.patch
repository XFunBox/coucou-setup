diff --git a/windows/tests/office-review.test.mjs b/windows/tests/office-review.test.mjs
new file mode 100644
index 0000000..e480da5
--- /dev/null
+++ b/windows/tests/office-review.test.mjs
@@ -0,0 +1,59 @@
+import { afterEach, beforeEach, mock, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { State, DEFAULT_SETTINGS } from '../src/core/state.ts';
+import { registerHookHandlers } from '../src/island/hooks.ts';
+import { registerOfficeRelay, officeSnapshot } from '../src/office/relay.ts';
+import { officeView } from '../src/office/view.ts';
+import { installFakeDom } from './fakedom.mjs';
+import { emit } from './tauri.mjs';
+
+const island = { alert() {}, setView() {}, reveal() {}, dropPin() {} };
+registerHookHandlers(island);
+await registerOfficeRelay(island);
+const hook = (session_id, hook_event_name, extra = {}) => emit('hook', { coucou_agent: 'codex', session_id, hook_event_name, cwd: `/projects/${session_id}`, ...extra });
+beforeEach(() => {
+  installFakeDom();
+  mock.timers.enable({apis:['setTimeout']});
+  State.tasks = []; State.officeAgents = []; State.focusId = null;
+  State.settings = {...DEFAULT_SETTINGS}; State.pendingApproval = null;
+  State.paused = false; State.mode = 'hidden'; State.view = 'overview';
+  State.loadIntegrationTasks();
+});
+afterEach(() => { mock.timers.runAll(); mock.timers.reset(); });
+
+test('session A details stay exact after session B activity on the same catalog pill', () => {
+  hook('A', 'PreToolUse', {tool_name:'Read', tool_input:{path:'one'}});
+  hook('B', 'PreToolUse', {tool_name:'Write', tool_input:{path:'two'}});
+  const deskA = State.officeAgents.find(agent => agent.sessionId === 'A');
+  const opened = [];
+  const view = officeView(request => opened.push(request));
+  view.update(officeSnapshot());
+  view.root.find('button').find(button => button.dataset.officeAgent === deskA.id).fire('click');
+  const details = view.root.find('.office-details')[0];
+  assert.ok(details.textContent.includes('/projects/A'));
+  assert.ok(details.textContent.includes('Session: A'));
+  assert.ok(details.textContent.includes('one'));
+  assert.ok(!details.textContent.includes('/projects/B'));
+  assert.deepEqual(opened, []);
+});
+
+test('working session details survive sibling stop timer without recreating catalog pills or replacing another answer card', () => {
+  hook('A', 'SessionStart');
+  hook('B', 'PreToolUse', {tool_name:'Bash', tool_input:{command:'long-running-job'}});
+  hook('A', 'Stop');
+  mock.timers.tick(5201);
+  const deskB = State.officeAgents.find(agent => agent.sessionId === 'B');
+  assert.equal(deskB.state, 'working');
+  const pending = {requestId:'waiting-A',sessionId:'A',pillId:'agent_codex',command:'confirm'};
+  State.pendingApproval = pending;
+  const tasksBefore = [...State.tasks];
+  const opened = [];
+  const view = officeView(request => { opened.push(request); emit('office-open', request); });
+  view.update(officeSnapshot());
+  view.root.find('button').find(button => button.dataset.officeAgent === deskB.id).fire('click');
+  assert.ok(view.root.find('.office-details')[0].textContent.includes('/projects/B'));
+  assert.ok(view.root.find('.office-details')[0].textContent.includes('long-running-job'));
+  assert.deepEqual(State.tasks, tasksBefore);
+  assert.equal(State.pendingApproval, pending);
+  assert.deepEqual(opened, []);
+});
diff --git a/windows/tests/office.test.mjs b/windows/tests/office.test.mjs
new file mode 100644
index 0000000..def8c94
--- /dev/null
+++ b/windows/tests/office.test.mjs
@@ -0,0 +1,90 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { officeStatus, requestForAgent } from '../src/office/model.ts';
+import { State } from '../src/core/state.ts';
+import { calls, emit, sent } from './tauri.mjs';
+import { installFakeDom } from './fakedom.mjs';
+
+const agent = (sessionId = 'one', subagentId) => ({
+  id: JSON.stringify(['agent_codex', sessionId, subagentId ?? '']), pillId: 'agent_codex',
+  sessionId, subagentId, name: 'Codex <script>', state: 'working', step: 'Edit src/app.ts', updatedAt: 1,
+});
+const pending = { requestId: 'request-one', sessionId: 'one', pillId: 'agent_codex', command: '',
+  questions: [{ question: 'SQLite <script> or PostgreSQL?', options: [], multiSelect: false }] };
+
+test('office ties answer bubbles to the exact session, never sibling sessions or subagents', () => {
+  const scene = { agents: [], pending };
+  assert.equal(requestForAgent(scene, agent()), pending);
+  assert.equal(requestForAgent(scene, agent('two')), null);
+  assert.equal(requestForAgent(scene, agent('one', 'worker')), null);
+  assert.equal(officeStatus(agent(), false), 'Writing');
+  assert.equal(officeStatus({ ...agent(), step: 'Bash npm test' }, false), 'Running');
+  assert.equal(officeStatus(agent(), true), 'Needs an answer');
+});
+
+test('empty office creates no synthetic agents; live desks safely render text and dispatch exact request IDs', async () => {
+  installFakeDom();
+  const { officeView } = await import('../src/office/view.ts');
+  const opened = [];
+  const view = officeView((request) => opened.push(request));
+  view.update({ agents: [], pending: null });
+  assert.equal(view.root.find('button').length, 0);
+  assert.ok(view.root.textContent.includes('Your office is ready'));
+  const scene = { agents: [agent(), agent('two')], pending };
+  view.update(scene);
+  const buttons = view.root.find('button');
+  assert.equal(buttons.length, 2);
+  assert.ok(buttons[0].textContent.includes('SQLite <script>'));
+  assert.equal(view.root.find('.office-bubble').length, 1);
+  buttons[0].fire('click');
+  buttons[1].fire('click');
+  assert.deepEqual(opened, [{ agentId: agent().id, requestId: pending.requestId }]);
+  assert.ok(view.root.find('.office-details')[0].textContent.includes('Session: two'));
+  view.update(scene);
+  assert.equal(view.root.find('button')[0], buttons[0], 'unchanged snapshots preserve DOM and keyboard focus');
+  const room = view.root.find('.office-room')[0];
+  room.contains = (node) => [...room.walk()].includes(node);
+  document.activeElement = buttons[1];
+  const originalCreateElement = document.createElement;
+  document.createElement = (tag) => {
+    const element = originalCreateElement(tag);
+    element.focus = () => { document.activeElement = element; };
+    return element;
+  };
+  view.update({ ...scene, agents: [agent(), { ...agent('two'), state: 'thinking' }] });
+  assert.equal(document.activeElement, view.root.find('button')[1], 'updated snapshots restore the same session keyboard focus');
+});
+
+test('island relay sends current state on subscribe and ignores stale answer requests', async () => {
+  const { registerOfficeRelay } = await import('../src/office/relay.ts');
+  const alerts = [];
+  State.officeAgents = [agent(), agent('two')];
+  State.pendingApproval = pending;
+  State.tasks = [{ id: 'agent_codex', name: 'Codex', state: 'working', steps: [] }];
+  await registerOfficeRelay({ alert: (view) => alerts.push(view) });
+  calls.length = 0;
+  emit('office-watch', true);
+  assert.ok(sent('plugin:event|emit_to').some((event) => event.event === 'office-snapshot' && event.payload.agents.length === 2));
+  emit('office-open', { agentId: agent('two').id, requestId: pending.requestId });
+  emit('office-open', { agentId: agent().id, requestId: 'expired' });
+  assert.deepEqual(alerts, []);
+  emit('office-open', { agentId: agent().id, requestId: pending.requestId });
+  assert.deepEqual(alerts, ['question']);
+  emit('office-watch', false);
+  calls.length = 0;
+  State.notify();
+  assert.equal(sent('plugin:event|emit_to').length, 0);
+});
+
+test('office page subscribes after listening and stops watching on navigation', async () => {
+  const dom = installFakeDom();
+  window.__TAURI_EVENT_PLUGIN_INTERNALS__ = { unregisterListener() {} };
+  const { officePage } = await import('../src/office/page.ts');
+  const ctx = { hero: () => dom.root() };
+  calls.length = 0;
+  await officePage(dom.root(), ctx);
+  assert.ok(sent('plugin:event|emit_to').some((event) => event.event === 'office-watch' && event.payload === true));
+  ctx.onLeave();
+  assert.ok(sent('plugin:event|emit_to').some((event) => event.event === 'office-watch' && event.payload === false));
+  assert.ok(sent('plugin:event|unlisten').length > 0);
+});

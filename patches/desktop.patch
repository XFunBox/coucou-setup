+export function requestForAgent(scene: OfficeSnapshot, agent: OfficeAgent) {
+  const req = scene.pending;
+  return req && !agent.subagentId && req.pillId === agent.pillId && req.sessionId === agent.sessionId ? req : null;
+}
+
+export function officeStatus(agent: OfficeAgent, pending: boolean): string {
+  if (pending || agent.state === "question") return t("Needs an answer");
+  switch (agent.state) {
+    case "working": return /write|edit|patch|writing|escrib/i.test(agent.step ?? "") ? t("Writing") : t("Running");
+    case "thinking": case "searching": return t("Thinking");
+    case "approval": return t("Needs approval");
+    case "finished": return t("Finished");
+    case "error": return t("Error");
+    case "ratelimit": return t("Rate limited");
+    default: return t("Idle");
+  }
+}

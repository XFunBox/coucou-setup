+++ b/windows/tests/codex-bridge.test.mjs
@@ -0,0 +1,149 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+const bridge = await import('../scripts/codex-bridge.mjs').catch(() => ({}));
+const request = (id = 7) => ({ id, method: 'item/tool/requestUserInput', params: { threadId: 'thread-a', turnId: 'turn-a', itemId: 'item-a', questions: [{ id: 'db', header: 'Database', question: 'Database?', isOther: false, isSecret: false, options: [{ label: 'SQLite', description: 'Local' }, { label: 'PostgreSQL', description: 'Server' }] }] } });
+const setup = (ask = async () => ({ answers: { 'Database?': 'SQLite' } })) => {
+  assert.equal(typeof bridge.createQuestionRouter, 'function');
+  const replies = [], events = [];
+  const router = bridge.createQuestionRouter({ ask, send: value => replies.push(value), event: value => events.push(value), timeoutMs: 20 });
+  return { router, replies, events };
+};
+
+test('Codex question round trip maps displayed choices back to original ids', async () => {
+  const { router, replies } = setup();
+  await router.handle(request());
+  assert.deepEqual(replies, [{ id: 7, result: { answers: { db: { answers: ['SQLite'] } } } }]);
+});
+
+test('two same-looking questions remain correlated and are queued', async () => {
+  let release;
+  const asked = [];
+  const { router, replies } = setup(async payload => { asked.push(payload); if (asked.length === 1) await new Promise(resolve => { release = resolve; }); return { answers: { 'Database?': 'SQLite' } }; });
+  const first = router.handle(request(1));
+  const second = router.handle(request(2));
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(asked.length, 1);
+  release();
+  await Promise.all([first, second]);
+  assert.deepEqual(replies.map(x => x.id), [1, 2]);
+});
+
+test('invalid answer, unavailable island and timeouts never invent an answer', async () => {
+  for (const ask of [async () => ({ answers: { 'Database?': 'injected' } }), async () => null, () => new Promise(() => {})]) {
+    const { router, replies } = setup(ask);
+    await router.handle(request());
+    assert.ok(replies[0].error);
+    assert.equal(replies[0].result, undefined);
+  }
+});
+
+test('server resolution cancels an active question and discards late answers', async () => {
+  let release;
+  const { router, replies, events } = setup(async () => { await new Promise(resolve => { release = resolve; }); return { answers: { 'Database?': 'SQLite' } }; });
+  const pending = router.handle(request());
+  await new Promise(resolve => setImmediate(resolve));
+  router.resolve({ threadId: 'thread-a', requestId: 7 });
+  release();
+  await pending;
+  assert.deepEqual(replies, []);
+  assert.equal(events.at(-1).hook_event_name, 'QuestionResolved');
+});
+
+test('secret, duplicate text, malformed, and unsupported questions are rejected', async () => {
+  for (const transform of [r => {r.params.questions[0].isSecret = true;}, r => {r.params.questions.push({...r.params.questions[0], id: 'other'});}, r => {r.params.questions[0].options = null;}, r => {r.params.questions[0].question = 'cut…';}]) {
+    const { router, replies } = setup(async () => { throw Error('must not ask'); });
+    const r = request(); transform(r);
+    await router.handle(r);
+    assert.ok(replies[0].error);
+  }
+});
+
+test('JSON-lines App Server client completes a real duplex question handshake', async () => {
+  const { PassThrough } = await import('node:stream');
+  const { EventEmitter } = await import('node:events');
+  const child = new EventEmitter(); child.stdin = new PassThrough(); child.stdout = new PassThrough();
+  const wire = [], events = [], output = [];
+  child.stdin.on('data', data => {
+    for (const line of data.toString().trim().split('\n')) {
+      const value = JSON.parse(line); wire.push(value);
+      if (value.method === 'initialize') child.stdout.write(JSON.stringify({id: value.id, result: {}}) + '\n');
+    }
+  });
+  const client = bridge.createClient(child, { relay: async payload => { events.push(payload); return { answers: { 'Database?': 'PostgreSQL' } }; }, output: text => output.push(text) });
+  try {
+    await client.rpc('initialize', { clientInfo: { name: 'test', version: '1' } });
+    child.stdout.write(JSON.stringify(request('request-original')) + '\n');
+    await new Promise(resolve => setImmediate(resolve));
+    assert.deepEqual(wire.at(-1), {id: 'request-original', result: {answers: {db: {answers: ['PostgreSQL']}}}});
+    child.stdout.write(JSON.stringify({method:'item/agentMessage/delta',params:{threadId:'thread-a',delta:'Continuing'}}) + '\n');
+    assert.deepEqual(output, ['Continuing']);
+    assert.equal(events[0].tool_name, 'AskUserQuestion');
+    assert.equal(events[0].coucou_agent, 'codex');
+  } finally { client.close(); }
+});
+
+test('command and file approvals require an explicit human allow and keep request identity', async () => {
+  for (const kind of ['commandExecution', 'fileChange']) {
+    for (const decision of ['allow', 'deny', undefined]) {
+      const { router, replies, events } = setup(async payload => { assert.equal(payload.tool_name, kind === 'commandExecution' ? 'Bash' : 'Codex file change'); assert.match(JSON.stringify(payload.tool_input), /original/); return decision ? {decision} : null; });
+      await router.handle({id:'approval-original', method:`item/${kind}/requestApproval`, params:{threadId:'thread-a',turnId:'turn-a',itemId:'original',command:'echo hello',grantRoot:'/project'}});
+      assert.equal(replies[0].id, 'approval-original');
+      if (decision) assert.equal(replies[0].result.decision, decision === 'allow' ? 'accept' : 'decline');
+      else assert.ok(replies[0].error);
+      assert.equal(events.at(-1).hook_event_name, 'QuestionResolved');
+    }
+  }
+});
+
+test('CLI spawns App Server and relay and resumes after a selected question', async () => {
+  const { mkdtemp, writeFile, rm, readFile } = await import('node:fs/promises');
+  const { tmpdir } = await import('node:os');
+  const { join, resolve } = await import('node:path');
+  const { execFile } = await import('node:child_process');
+  const { promisify } = await import('node:util');
+  const dir = await mkdtemp(join(tmpdir(), 'coucou-bridge-'));
+  try {
+    const server = join(dir, 'server.mjs'), hook = join(dir, 'hook.mjs'), record = join(dir, 'wire.json'), hooksRecord = join(dir, 'hooks.jsonl');
+    await writeFile(server, `import {createInterface} from 'node:readline'; import {writeFileSync} from 'node:fs'; const send=x=>console.log(JSON.stringify(x)); createInterface({input:process.stdin}).on('line',line=>{const m=JSON.parse(line); if(m.method==='initialize') send({id:m.id,result:{}}); if(m.method==='thread/start'){if(m.params.sandbox!=='workspace-write'||m.params.approvalPolicy!=='on-request'){send({id:m.id,error:{code:-32602,message:'Invalid sandbox or approvalPolicy for rust-v0.159.2'}});return;} send({id:m.id,result:{thread:{id:'spawned-thread'},model:'test-model'}});} if(m.method==='turn/start'){if(m.params.collaborationMode?.mode!=='plan'||m.params.collaborationMode?.settings.model!=='test-model'||m.params.collaborationMode.settings.reasoning_effort!=='medium'||m.params.collaborationMode.settings.developer_instructions!==null){send({id:m.id,error:{code:-32602,message:'Invalid plan contract'}});return;}send({method:'turn/started',params:{threadId:'spawned-thread',turn:{id:'spawned-turn'}}});send({method:'item/started',params:{threadId:'spawned-thread',item:{id:'read',type:'commandExecution',command:'echo test'}}});send({id:m.id,result:{turn:{id:'spawned-turn'}}});send({id:91,method:'item/tool/requestUserInput',params:{threadId:'spawned-thread',turnId:'spawned-turn',itemId:'q',isBlocking:true,autoResolutionMs:null,questions:[{id:'db',header:'Database',question:'Database?',isOther:false,isSecret:false,options:[{label:'SQLite',description:'Local'},{label:'PostgreSQL',description:'Server'}]}]}});} if(m.id===91 && m.result){writeFileSync(${JSON.stringify(record)},JSON.stringify(m));send({method:'item/agentMessage/delta',params:{threadId:'spawned-thread',delta:'Resumed with '+m.result.answers.db.answers[0]}});send({method:'turn/completed',params:{threadId:'spawned-thread',turn:{id:'spawned-turn',status:'completed'}}});}});`);
+    await writeFile(hook, `import {appendFileSync} from 'node:fs'; let raw=''; for await (const chunk of process.stdin) raw+=chunk; const p=JSON.parse(raw); appendFileSync(${JSON.stringify(hooksRecord)},JSON.stringify(p)+'\\n'); if(p.hook_event_name==='PermissionRequest'&&p.cwd!==${JSON.stringify(dir)}) throw Error('Wrong project cwd'); if(p.hook_event_name==='PermissionRequest') console.log(JSON.stringify({answers:{'Database?':'PostgreSQL'}}));`);
+    const result = await promisify(execFile)(process.execPath, [resolve('scripts/codex-bridge.mjs'), '--codex', server, '--hook', hook, '--cwd', dir, '--plan', 'Ask which database'], {timeout:10000});
+    assert.match(result.stdout, /Resumed with PostgreSQL/);
+    assert.equal(JSON.parse(await readFile(record,'utf8')).id, 91);
+    const emitted = (await readFile(hooksRecord,'utf8')).trim().split('\n').map(line => JSON.parse(line));
+    for (const name of ['UserPromptSubmit', 'PreToolUse', 'PermissionRequest']) assert.equal(emitted.find(event => event.hook_event_name === name)?.cwd, dir);
+  } finally { await rm(dir, {recursive:true,force:true}); }
+});
+
+test('approval preview includes command and additional permissions together', async () => {
+  const { router, replies } = setup(async payload => {
+    assert.match(payload.tool_input.command, /outside/);
+    assert.match(payload.tool_input.command, /echo hello/);
+    return {decision:'allow'};
+  });
+  await router.handle({id:8,method:'item/commandExecution/requestApproval',params:{threadId:'thread-a',turnId:'turn-a',itemId:'original',command:'echo hello',additionalPermissions:{fileSystem:{write:['/outside']}}}});
+  assert.equal(replies[0].result?.decision,'accept');
+});
+
+test('server timeout includes time in the queue and never displays expired requests', async () => {
+  let release; let asked = 0;
+  const { router, replies } = setup(async () => { asked++; await new Promise(resolve => {release=resolve;}); return {answers:{'Database?':'SQLite'}}; });
+  const first = router.handle(request(1));
+  const expired = request(2); expired.params.autoResolutionMs = 1;
+  const second = router.handle(expired);
+  await new Promise(resolve => setTimeout(resolve, 5)); release();
+  await Promise.all([first, second]);
+  assert.equal(asked,1);
+  assert.match(replies.at(-1).error.message,/expired/);
+});
+
+test('completed assistant message becomes the office final line', async () => {
+  const { PassThrough } = await import('node:stream');
+  const { EventEmitter } = await import('node:events');
+  const child=new EventEmitter(); child.stdin=new PassThrough(); child.stdout=new PassThrough();
+  const events=[];
+  const client=bridge.createClient(child,{relay:async payload=>{events.push(payload);return null;},output:()=>{}});
+  child.stdout.write(JSON.stringify({method:'item/completed',params:{threadId:'t',item:{type:'agentMessage',id:'a',text:'Database selected.'}}})+'\n');
+  child.stdout.write(JSON.stringify({method:'turn/completed',params:{threadId:'t',turn:{id:'turn',status:'completed'}}})+'\n');
+  assert.equal(events.find(x=>x.hook_event_name==='Stop')?.last_assistant_message,'Database selected.');
+  client.close();
+});
